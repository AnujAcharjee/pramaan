<% layout("layouts/main") %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 bg-transparent relative z-10 animate-slideIn">
  <div class="w-full max-w-lg text-center glass-card p-8 sm:p-12">

    <!-- Illustration -->
    <div class="flex justify-center mb-8 hover-scale">
      <img src="/images/500 Internal Server.svg" alt="500 Internal Server Error" class="w-64 sm:w-80 h-auto drop-shadow-md">
    </div>

    <!-- Heading -->
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight font-brand-hero">
      <%= typeof statusCode !== 'undefined' && statusCode < 500 ? (typeof title !== 'undefined' && title !== 'Error-Page' ? title : 'Request Error') : 'Internal Server Error' %>
    </h1>

    <p class="text-slate-500 dark:text-slate-400 mb-8 font-semibold">
      <%= typeof message !== 'undefined' && message ? message : 'Something went wrong on our side.' %>
    </p>

    <% if (typeof error !== 'undefined' && error && error !== message) { %>
    <div class="mb-8 p-4 rounded-2xl bg-rose-50/50 dark:bg-rose-950/30 border border-rose-100 dark:border-rose-900/40 text-left shadow-xs">
      <code class="text-xs font-mono text-rose-700 dark:text-rose-400 wrap-break-words block"><%= error %></code>
    </div>
    <% } %>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">

      <a href="/account" class="btn-sky text-sm shadow-lg shadow-sky-500/10">
        Go to Dashboard
      </a>

      <a href="/" class="btn-orange text-sm shadow-lg shadow-brand-orange/10">
        Go to Landing
      </a>

    </div>

    <!-- Divider -->
    <div class="mt-12 pt-8 border-t border-slate-200/40">
      <p class="text-xs text-slate-400 font-semibold">
        If this problem persists, please contact support.
      </p>
    </div>

  </div>
</div>