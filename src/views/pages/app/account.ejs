</div>

<script>
  function handleRemoveAvatarClick(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const avatarInput = document.getElementById('avatar-input');
    const avatarPreview = document.getElementById('avatar-preview');
    const removeAvatarForm = document.getElementById('remove-avatar-form');
    const triggerBtn = document.getElementById('trigger-remove-avatar-btn');
    const undoBtn = document.getElementById('undo-avatar-btn');

    const hadLocalFile = Boolean(avatarInput && avatarInput.files && avatarInput.files.length > 0);
    const hasServerAvatar = Boolean(avatarPreview && avatarPreview.dataset.hasServerAvatar === 'true');

    if (hadLocalFile) {
      avatarInput.value = '';
      if (undoBtn) {
        undoBtn.classList.add('hidden');
        undoBtn.classList.remove('inline-flex');
      }
    }

    if (hasServerAvatar) {
      if (confirm('Are you sure you want to remove your profile avatar?')) {
        if (removeAvatarForm) {
          removeAvatarForm.submit();
        }
      } else if (hadLocalFile && avatarPreview) {
        avatarPreview.src = '<%= _avatar %>';
      }
    } else {
      if (avatarPreview) {
        avatarPreview.src = '/images/default-avatar.png';
      }
      if (triggerBtn) {
        triggerBtn.classList.add('hidden');
        triggerBtn.classList.remove('inline-flex');
      }
    }
  }
</script>

