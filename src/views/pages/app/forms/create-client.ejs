<% layout("layouts/main") %>

<%
  const fd = typeof formData !== 'undefined' && formData ? formData : {};
%>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-2xl">
    <!-- Main Card -->
    <div class="glass-card p-8 sm:p-10 hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <%- include("../../../partials/form/header", {
        title: "Create New Client",
        subtitle: "Set up OAuth credentials and configure access for your client application."
      }) %>

      <%- include("../../../partials/alert", {success, error}) %>

      <form method="POST" action="/create-client" class="space-y-6 mt-8">

        <%- include("../../../partials/form/input", {
          id: "name",
          name: "name",
          type: "text",
          label: "Client Name",
          placeholder: "My Awesome App",
          value: fd.name ?? "",
          required: true,
          autocomplete: "name",
          helperText: "A friendly name to identify your client"
        }) %>

        <%- include("../../../partials/form/input", {
          id: "domain",
          name: "domain",
          type: "text",
          label: "Client Domain",
          placeholder: "xyz.com",
          value: fd.domain ?? "",
          required: true,
          autocomplete: "off",
          helperText: "Actual domain where your app is hosted (e.g. xyz.com or app.xyz.com - not a URL)"
        }) %>

        <%- include("../../../partials/form/select", {
          id: "client_type",
          name: "client_type",
          label: "Client Type",
          value: fd.client_type || "CONFIDENTIAL",
          required: true,
          options: [
            { value: "CONFIDENTIAL", label: "Confidential (Server-side apps)" },
            { value: "PUBLIC", label: "Public (SPAs / Mobile apps)" }
          ],
          helperText: "Determines authentication method and security requirements"
        }) %>

        <%- include("../../../partials/form/select", {
          id: "client_environment",
          name: "client_environment",
          label: "Environment",
          value: fd.client_environment || "development",
          required: true,
          options: [
            { value: "development", label: "Development (localhost HTTP allowed)" },
            { value: "production", label: "Production (HTTPS only)" }
          ],
          helperText: "Controls redirect URI policy for this client"
        }) %>

        <%- include("../../../partials/form/input", {
          id: "redirect_uri",
          name: "redirect_uri",
          type: "url",
          label: "Redirect URI",
          placeholder: "https://xyz.com/oauth/callback",
          value: fd.redirect_uri ?? "",
          required: true,
          autocomplete: "off",
          helperText: "Must match registered domain in production (or localhost/127.0.0.1 in development)"
        }) %>

        <!-- Info Box -->
        <div class="rounded-2xl border border-sky-200 bg-sky-50/50 dark:bg-sky-950/20 dark:border-sky-900/40 p-4 shadow-xs">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-sky-600 dark:text-sky-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="flex-1">
              <p class="text-xs font-bold text-sky-900 dark:text-sky-300">What happens next?</p>
              <p class="text-[11px] text-sky-800 dark:text-sky-400 leading-normal mt-0.5">After registering, you'll receive a Client ID and a Client Secret (for confidential clients) to identify the application in authorization flows.</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
          <a href="/account" class="btn-outline-sky text-center">
            Back
          </a>

          <button type="submit" class="btn-orange shadow-lg shadow-brand-orange/10 font-bold">
            Create client
          </button>
        </div>

      </form>
    </div>
  </div>
</div>