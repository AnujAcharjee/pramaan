<% layout("layouts/main") %>

<%
  const isDelete = action === 'delete';
  const isActivate = action === 'activate';
  const isRevoke = action === 'revoke-consent';
  const isReissue = action === 'reissue-consent';
  const isChangePassword = action === 'change-password';
  const isMfaEnable = action === 'mfa-enable';
  const isMfaDisable = action === 'mfa-disable';
  const isMfa = isMfaEnable || isMfaDisable;
  const isDeactivate = !(
    isDelete ||
    isActivate ||
    isRevoke ||
    isReissue ||
    isChangePassword ||
    isMfa
  );
%>

<div class="max-w-3xl mx-auto py-10 px-4 space-y-6 animate-slideIn relative z-10">

  <!-- Back -->
  <a href="/account" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 transition-colors">
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Account
  </a>

  <section class="glass-card p-6 sm:p-8">

    <!-- Header -->
    <div class="flex items-start gap-4 mb-6 pb-6 border-b border-slate-100 dark:border-slate-800/80">

      <div class="dashboard-icon bg-brand-orange">
        <svg class="w-6 h-6 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <div class="min-w-0">
        <h1 class="text-xl font-bold text-slate-900 dark:text-white leading-tight">
          <%= isDelete
              ? 'Delete Account'
              : isActivate
                ? 'Activate Account'
                : isRevoke
                  ? 'Revoke OAuth Consent'
                  : isReissue
                    ? 'Reissue OAuth Consent'
                    : isChangePassword
                      ? 'Send Password Reset Email'
                      : isMfaEnable
                        ? 'Enable Two-Factor Authentication'
                        : isMfaDisable
                          ? 'Disable Two-Factor Authentication'
                          : 'Deactivate Account'
          %>
        </h1>
        <p class="text-xs font-semibold text-slate-400 dark:text-slate-300 mt-1">
          Please confirm this action.
        </p>
      </div>
    </div>

    <!-- Context Notice -->
    <div class="rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/60 dark:border-slate-800/80 p-5 mb-8">
      <% if (isDelete) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        This action is permanent. All associated data will be removed and cannot be recovered.
      </p>
      <% } else if (isRevoke) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        OAuth consent will be revoked for
        <span class="font-bold text-slate-900 dark:text-white"><%= clientDomain || 'this application' %></span>.
      </p>
      <% } else if (isReissue) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        OAuth consent will be reissued for
        <span class="font-bold text-slate-900 dark:text-white"><%= clientDomain || 'this application' %></span>.
      </p>
      <% } else if (isChangePassword) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        We will send a password reset email to your registered email address.
      </p>
      <% } else if (isMfaEnable) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        Two-factor authentication will be enabled for your account.
      </p>
      <% } else if (isMfaDisable) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        Two-factor authentication will be disabled for your account.
      </p>
      <% } else if (isActivate) { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        Your account access will be restored immediately.
      </p>
      <% } else { %>
      <p class="text-xs font-medium text-slate-700 dark:text-slate-100 leading-relaxed">
        Your account will be deactivated and access will be disabled.
      </p>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="flex justify-end items-center gap-3">

      <a href="/account" class="btn-outline-gray !py-2 !px-4 !text-xs">
        Cancel
      </a>

      <% if (isDelete) { %>
      <form method="POST" action="/account?_method=DELETE">
        <input type="hidden" name="_method" value="DELETE">
        <% } else if (isRevoke) { %>
        <form method="POST" action="/consent/revoke">
          <input type="hidden" name="client_id" value="<%= clientId %>">
          <% } else if (isReissue) { %>
          <form method="POST" action="/consent/reissue">
            <input type="hidden" name="client_id" value="<%= clientId %>">
            <% } else if (isChangePassword) { %>
            <form method="POST" action="/account/change-password">
              <% } else if (isMfa) { %>
              <form method="POST" action="/account/mfa">
                <input type="hidden" name="action" value="<%= isMfaEnable ? 'enable' : 'disable' %>">
                <% } else if (isActivate) { %>
            <form method="POST" action="/account/activate">
              <% } else { %>
              <form method="POST" action="/account/deactivate">
                <% } %>

                <button type="submit" class="inline-flex items-center justify-center font-bold transition-all duration-300 active:scale-[0.98] border-2 rounded-xl py-2 px-5 text-xs cursor-pointer
            <%= (isDelete || isRevoke || isMfaDisable)
                ? 'border-rose-500 text-rose-500 dark:text-rose-400 dark:border-rose-500/80 hover:bg-rose-500 hover:text-white dark:hover:bg-rose-500 dark:hover:text-white'
                : (isActivate || isMfaEnable)
                  ? 'border-green-500 text-green-600 dark:text-emerald-400 dark:border-emerald-500/80 hover:bg-green-500 hover:text-white dark:hover:bg-emerald-500 dark:hover:text-white'
                  : 'border-sky-500 text-sky-600 dark:text-sky-400 dark:border-sky-500/80 hover:bg-sky-500 hover:text-white dark:hover:bg-sky-500 dark:hover:text-white'
            %>">
                  <%= isDelete
              ? 'Delete Account'
              : isRevoke
                ? 'Revoke Consent'
                : isReissue
                  ? 'Reissue Consent'
                  : isChangePassword
                    ? 'Send Reset Email'
                    : isMfaEnable
                      ? 'Enable 2FA'
                      : isMfaDisable
                        ? 'Disable 2FA'
                        : isActivate
                          ? 'Activate Account'
                          : 'Deactivate Account'
          %>
                </button>
              </form>

    </div>

  </section>

</div>
