<% layout("layouts/main") %>

<%
  const _currentEnvironment = typeof currentEnvironment !== 'undefined' ? currentEnvironment : null;
  const _targetEnvironment =
    typeof targetEnvironment !== 'undefined' && targetEnvironment ?
      targetEnvironment
    : _currentEnvironment ?
      (_currentEnvironment === 'development' ? 'production' : 'development')
    : null;
  const _httpRedirectCount = typeof httpRedirectCount === 'number' ? httpRedirectCount : 0;
  const _httpsRedirectCount = typeof httpsRedirectCount === 'number' ? httpsRedirectCount : 0;

  const isDelete = action === 'delete';
  const isActivate = action === 'activate';
  const isDeactivate = action === 'deactivate';
  const isEnvironment = action === 'environment';
  const isProdSwitch = isEnvironment && _targetEnvironment === 'production';
  const willRemoveHttp = isProdSwitch && _httpRedirectCount > 0;
  const cannotProceed = isProdSwitch && _httpsRedirectCount === 0;

  const confirmText =
    isDelete
      ? 'Delete Client'
      : isActivate
        ? 'Activate Client'
        : isEnvironment
          ? `Switch to ${_targetEnvironment === 'production' ? 'Production' : 'Development'}`
          : 'Deactivate Client';
%>

<div class="max-w-3xl mx-auto py-10 px-4 space-y-6 animate-slideIn relative z-10">

  <!-- Back -->
  <a href="/client/<%= clientId %>" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 transition-colors">
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Client Dashboard
  </a>

  <!-- Card -->
  <section class="glass-card p-6 sm:p-8">

    <!-- Header -->
    <div class="flex items-start gap-4 mb-6 pb-6 border-b border-slate-100 dark:border-slate-800/80">

      <div class="dashboard-icon bg-brand-orange">
        <svg class="w-6 h-6 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <div class="min-w-0">
        <h1 class="text-xl font-bold text-slate-900 dark:text-slate-100 leading-tight">
          <%= isDelete
              ? 'Delete Client'
              : isActivate
                ? 'Activate Client'
                : isEnvironment
                  ? 'Switch Environment'
                  : 'Deactivate Client' %>
        </h1>
        <p class="text-xs font-semibold text-slate-400 dark:text-slate-400 mt-1">
          Please confirm this action.
        </p>
      </div>
    </div>

    <!-- Context Block -->
    <div class="rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/60 dark:border-slate-800/80 p-5 mb-6">
      <p class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-2">
        Are you sure?
      </p>

      <% if (isDelete) { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        This action is permanent. All client credentials, redirect URIs,
        and secrets will be removed and cannot be recovered.
      </p>
      <% } else if (isActivate) { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        The client will be re-enabled for OAuth authorization and token requests.
      </p>
      <% } else if (isEnvironment) { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        This will switch the environment from
        <span class="font-extrabold text-slate-900 dark:text-white"><%= _currentEnvironment %></span>
        to
        <span class="font-extrabold text-slate-900 dark:text-white"><%= _targetEnvironment %></span>.
      </p>
      <% if (willRemoveHttp) { %>
      <div class="mt-4 rounded-xl border border-amber-200 dark:border-amber-500/30 bg-amber-50/50 dark:bg-amber-500/10 p-3">
        <p class="text-xs text-amber-800 dark:text-amber-300 font-semibold leading-relaxed">
          ⚠️ <%= _httpRedirectCount %> HTTP redirect URI<%= _httpRedirectCount > 1 ? 's' : '' %> will be removed in production. Use HTTPS to keep them.
        </p>
      </div>
      <% } %>
      <% if (cannotProceed) { %>
      <div class="mt-3 rounded-xl border border-rose-200 dark:border-rose-500/30 bg-rose-50/50 dark:bg-rose-500/10 p-3">
        <p class="text-xs text-rose-700 dark:text-rose-300 font-semibold leading-relaxed">
          🚫 Add at least one HTTPS redirect URI before switching to production.
        </p>
      </div>
      <% } %>
      <% } else { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        The client will stop accepting OAuth authorization and token requests.
        It can be reactivated later.
      </p>
      <% } %>
    </div>

    <!-- App Info -->
    <div class="rounded-2xl bg-slate-50 border border-slate-200/60 p-5 mb-8">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">
        Client Application
      </p>
      <p class="text-sm font-extrabold text-slate-900">
        <%= name %>
      </p>
      <p class="text-xs font-mono text-slate-500 mt-1 select-all">
        <%= clientId %>
      </p>
    </div>

    <!-- Actions -->
    <div class="flex justify-end items-center gap-3">

      <a href="/client/<%= clientId %>" class="btn-outline-gray !py-2 !px-4 !text-xs">
        Cancel
      </a>

      <form method="POST" action="/client/<%= clientId %><%= isDelete
              ? '?_method=DELETE'
              : isActivate
                ? '/activate'
                : isEnvironment
                  ? '/environment'
                  : '?_method=PUT' %>">
        <% if (isEnvironment) { %>
        <input type="hidden" name="environment" value="<%= _targetEnvironment %>">
        <% } %>

        <button type="submit" <%= cannotProceed ? 'disabled' : '' %> class="inline-flex items-center justify-center font-bold transition-all duration-300 active:scale-[0.98] border-2 rounded-xl py-2 px-5 text-xs cursor-pointer
            <%= isDelete
                ? 'border-rose-500 text-rose-500 hover:bg-rose-500 hover:text-white'
                : isActivate
                  ? 'border-green-500 text-green-600 hover:bg-green-500 hover:text-white'
                  : isEnvironment
                    ? 'border-sky-500 text-sky-600 hover:bg-sky-500 hover:text-white'
                    : 'border-slate-500 text-slate-650 hover:bg-slate-500 hover:text-white'
            %> <%= cannotProceed ? 'opacity-50 cursor-not-allowed' : '' %>">
          <%= confirmText %>
        </button>

      </form>

    </div>

  </section>

</div>