<% layout("layouts/main") %>

<%
  const _currentEnvironment = typeof currentEnvironment !== 'undefined' ? currentEnvironment : null;
  const _targetEnvironment =
    typeof targetEnvironment !== 'undefined' && targetEnvironment ?
      targetEnvironment
    : _currentEnvironment ?
      (_currentEnvironment === 'development' ? 'production' : 'development')
    : null;
  const _httpRedirectCount = typeof httpRedirectCount === 'number' ? httpRedirectCount : 0;
  const _httpsRedirectCount = typeof httpsRedirectCount === 'number' ? httpsRedirectCount : 0;

  const isDelete = action === 'delete';
  const isActivate = action === 'activate';
  const isDeactivate = action === 'deactivate';
  const isEnvironment = action === 'environment';
  const isProdSwitch = isEnvironment && _targetEnvironment === 'production';
  const _redirectCount = typeof redirectCount === 'number' ? redirectCount : (_httpRedirectCount + _httpsRedirectCount);

  const confirmText =
    isDelete
      ? 'Delete Client'
      : isActivate
        ? 'Activate Client'
        : isEnvironment
          ? `Switch to ${_targetEnvironment === 'production' ? 'Production' : 'Development'}`
          : 'Deactivate Client';
%>

<div class="max-w-3xl mx-auto py-10 px-4 space-y-6 animate-slideIn relative z-10">

  <!-- Back -->
  <a href="/client/<%= clientId %>" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 transition-colors">
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Client Dashboard
  </a>

  <!-- Card -->
  <section class="glass-card p-6 sm:p-8">

    <!-- Header -->
    <div class="flex items-start gap-4 mb-6 pb-6 border-b border-slate-100 dark:border-slate-800/80">

      <div class="dashboard-icon bg-brand-orange">
        <svg class="w-6 h-6 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <div class="min-w-0">
        <h1 class="text-xl font-bold text-slate-900 dark:text-slate-100 leading-tight">
          <%= isDelete
              ? 'Delete Client'
              : isActivate
                ? 'Activate Client'
                : isEnvironment
                  ? 'Switch Environment'
                  : 'Deactivate Client' %>
        </h1>
        <p class="text-xs font-semibold text-slate-400 dark:text-slate-400 mt-1">
          Please confirm this action.
        </p>
      </div>
    </div>

    <!-- Context Block -->
    <div class="rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/60 dark:border-slate-800/80 p-5 mb-6">
      <p class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-2">
        Are you sure?
      </p>

      <% if (isDelete) { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        This action is permanent. All client credentials, redirect URIs,
        and secrets will be removed and cannot be recovered.
      </p>
      <% } else if (isActivate) { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        The client will be re-enabled for OAuth authorization and token requests.
      </p>
      <% } else if (isEnvironment) { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        This will switch the environment from
        <span class="font-extrabold text-slate-900 dark:text-white uppercase"><%= _currentEnvironment %></span>
        to
        <span class="font-extrabold text-slate-900 dark:text-white uppercase"><%= _targetEnvironment %></span>.
      </p>
      <% if (isProdSwitch) { %>
      <div class="mt-4 rounded-xl border border-amber-300 dark:border-amber-500/40 bg-amber-50/70 dark:bg-amber-500/10 p-4">
        <div class="flex items-start gap-2.5">
          <span class="text-base select-none mt-0.5">⚠️</span>
          <div>
            <p class="text-xs text-amber-900 dark:text-amber-200 font-bold leading-relaxed">
              All saved redirect URIs will be deleted upon switching to Production.
            </p>
            <p class="text-[11px] text-amber-800 dark:text-amber-300/90 leading-relaxed mt-1">
              <% if (_redirectCount > 0) { %>
              You currently have <span class="font-bold"><%= _redirectCount %></span> saved redirect URI(s) that will be removed.
              <% } %>
              In Production mode, you will need to re-add redirect URIs that use HTTPS and strictly match your registered domain (<span class="font-bold font-mono"><%= typeof domain !== 'undefined' && domain ? domain : 'xyz.com' %></span>).
            </p>
          </div>
        </div>
      </div>
      <% } %>
      <% } else { %>
      <p class="text-xs text-slate-600 dark:text-slate-200 leading-relaxed font-medium">
        The client will stop accepting OAuth authorization and token requests.
        It can be reactivated later.
      </p>
      <% } %>
    </div>

    <!-- App Info -->
    <div class="rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/60 dark:border-slate-800/80 p-5 mb-8">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">
        Client Application
      </p>
      <p class="text-sm font-extrabold text-slate-900 dark:text-slate-100">
        <%= name %>
      </p>
      <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1 select-all">
        <%= clientId %>
      </p>
    </div>

    <!-- Actions -->
    <div class="flex justify-end items-center gap-3">

      <a href="/client/<%= clientId %>" class="btn-outline-gray !py-2 !px-4 !text-xs">
        Cancel
      </a>

      <form method="POST" action="/client/<%= clientId %><%= isDelete
              ? '?_method=DELETE'
              : isActivate
                ? '/activate'
                : isEnvironment
                  ? '/environment'
                  : '?_method=PUT' %>">
        <% if (isEnvironment) { %>
        <input type="hidden" name="environment" value="<%= _targetEnvironment %>">
        <% } %>

        <button type="submit" class="inline-flex items-center justify-center font-bold transition-all duration-300 active:scale-[0.98] border-2 rounded-xl py-2 px-5 text-xs cursor-pointer
            <%= isDelete
                ? 'border-rose-500 text-rose-500 dark:text-rose-400 dark:border-rose-500/80 hover:bg-rose-500 hover:text-white dark:hover:bg-rose-500 dark:hover:text-white'
                : isActivate
                  ? 'border-green-500 text-green-600 dark:text-emerald-400 dark:border-emerald-500/80 hover:bg-green-500 hover:text-white dark:hover:bg-emerald-500 dark:hover:text-white'
                  : isEnvironment
                    ? 'border-sky-500 text-sky-600 dark:text-sky-400 dark:border-sky-500/80 hover:bg-sky-500 hover:text-white dark:hover:bg-sky-500 dark:hover:text-white'
                    : 'border-slate-500 text-slate-600 dark:text-slate-300 dark:border-slate-600 hover:bg-slate-500 hover:text-white dark:hover:bg-slate-600 dark:hover:text-white'
            %>">
          <%= confirmText %>
        </button>

      </form>

    </div>

  </section>

</div>