<% layout("layouts/main") %>

<%
  const _variant = typeof variant !== 'undefined' ? variant : 'default'; // default | success | warning | danger | info
  const _size = typeof size !== 'undefined' ? size : 'md'; // sm | md
  const _text = typeof text !== 'undefined' ? text : '';

  const _renderPartial = typeof include === 'function'
      ? include
      : (typeof partial === 'function' ? partial : null);

  const variantClasses = {
    default: 'bg-slate-100 dark:bg-slate-800/40 text-slate-700 dark:text-slate-400',
    success: 'bg-green-100 dark:bg-emerald-500/10 text-green-700 dark:text-emerald-400 ring-1 ring-green-200 dark:ring-emerald-500/20',
    warning: 'bg-amber-100 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 ring-1 ring-amber-200 dark:ring-amber-500/20',
    danger: 'bg-red-100 dark:bg-rose-500/10 text-red-700 dark:text-rose-400 ring-1 ring-red-200 dark:ring-rose-500/20',
    info: 'bg-sky-100 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 ring-1 ring-sky-200 dark:ring-sky-500/20'
  };

  const isVercelDomain = Boolean(
    client.domain &&
    client.domain.trim().toLowerCase().endsWith('.vercel.app') &&
    client.domain.trim().toLowerCase().length > '.vercel.app'.length
  );

  const _warning = typeof warning !== 'undefined' ? warning : undefined;
%>

<% if (_renderPartial) { %>
<%- _renderPartial("../../../partials/alert", { success, error, warning: _warning }) %>
<% } %>

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8 animate-slideIn relative z-10">
  <script src="/js/dashboard-scroll.js"></script>

  <!-- Back Button -->
  <div class="flex">
    <a href="/account" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-brand-orange transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Dashboard
    </a>
  </div>

  <!-- Page Header -->
  <div class="border-b border-slate-200/40 dark:border-slate-800/40 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">Client Dashboard</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Configure client details, secrets, environments, and authorization URLs.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <!-- Theme Switch Button -->
      <button id="themeToggle" class="btn-outline-gray !py-2 !px-4 !text-xs shrink-0 flex items-center justify-center gap-2">
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span class="hidden dark:block">Light Mode</span>
        <span class="block dark:hidden">Dark Mode</span>
      </button>

      <%
        const isClientDev = client.environment === 'development' || client.domain === 'localhost';
      %>
      <% if (!client.isActive) { %>
      <span class="inline-flex items-center font-bold rounded-full px-3.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800/40 text-slate-700 dark:text-slate-400">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>
        Disabled
      </span>
      <% } else if (isClientDev) { %>
      <span class="inline-flex items-center font-bold rounded-full px-3.5 py-1.5 text-xs bg-amber-100 text-amber-800 ring-1 ring-amber-300/60 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
        DEV
      </span>
      <% } else { %>
      <span class="inline-flex items-center font-bold rounded-full px-3.5 py-1.5 text-xs <%= variantClasses['success'] %>">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5 animate-pulse"></span>
        Active
      </span>
      <% } %>
    </div>
  </div>

  <%
    const isEditing = typeof edit !== 'undefined' && edit === true;
    const focusDomain = typeof target !== 'undefined' && target === 'domain';
  %>

  <% if (client.environment === 'development') { %>
  <div class="p-3.5 rounded-2xl bg-amber-100 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/30 flex items-center justify-between gap-4 text-xs shadow-xs">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-7 h-7 rounded-xl bg-amber-200/80 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="font-bold text-amber-900 dark:text-amber-200">Developer Mode Active</p>
        <p class="text-amber-800 dark:text-amber-300/90 mt-0.5 leading-normal font-medium">
          This client is in development mode. Unverified domains and localhost callbacks are allowed for testing only.
        </p>
      </div>
    </div>
  </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Overview & Configuration (Left) -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- App Overview -->
      <section class="dashboard-section">
        <!-- Standalone hidden avatar forms for SSR upload and removal -->
        <form id="client-avatar-upload-form" action="/client/<%= client.id %>/avatar" method="POST" enctype="multipart/form-data" class="hidden">
          <input type="file" id="client-avatar-file-input" name="avatar" accept="image/*" class="hidden" />
        </form>
        <form id="client-remove-avatar-form" action="/client/<%= client.id %>/avatar" method="POST" class="hidden">
          <input type="hidden" name="action" value="remove" />
        </form>

        <form id="edit-details-form" action="/client/<%= client.id %>/settings" method="POST">
          <div class="flex items-start sm:items-center justify-between gap-4 mb-6 flex-wrap">
            <div class="flex items-start sm:items-center gap-4">
              <!-- Client Avatar / Logo (Replacing generic icon, matching its exact position and proportions) -->
              <div class="relative group/logo shrink-0">
                <label for="client-avatar-file-input" class="cursor-pointer block relative" title="Click to upload client logo">
                  <div class="dashboard-icon !p-0 !bg-none bg-slate-200 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 shadow-sm overflow-hidden flex items-center justify-center">
                    <% if (client.avatar) { %>
                      <img id="client-avatar-preview" src="<%= client.avatar %>" alt="<%= client.name %>" class="w-full h-full object-cover" />
                    <% } else { %>
                      <span class="text-sm font-black tracking-wider text-slate-700 dark:text-slate-200">
                        <%= client.name.trim().slice(0, 2).toUpperCase() %>
                      </span>
                    <% } %>
                  </div>

                  <!-- Camera Icon Badge Overlay on bottom-right -->
                  <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-brand-orange text-white flex items-center justify-center shadow-xs ring-2 ring-white dark:ring-[#0f121d] group-hover/logo:scale-110 transition-transform" title="Upload Logo">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                </label>
              </div>

              <div class="min-w-0 flex-1 space-y-1">
                <!-- Name Row (Static & Edit in-place matching account.ejs) -->
                <h2 id="name-display" class="<%= isEditing ? 'hidden' : '' %> text-2xl font-extrabold text-slate-900 dark:text-slate-100 truncate">
                  <%= client.name %>
                </h2>
                <div id="name-input-wrapper" class="<%= isEditing ? 'block' : 'hidden' %> relative group/name max-w-sm">
                  <input type="text" id="edit-name" name="name" value="<%= client.name %>" required class="w-full text-2xl font-extrabold text-slate-900 dark:text-slate-100 bg-transparent border-b border-dashed border-slate-300 dark:border-slate-700 focus:border-brand-orange focus:outline-none transition-colors pr-6" placeholder="Client Name" />
                  <div class="absolute right-0 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 opacity-40 group-hover/name:opacity-100 transition-opacity pointer-events-none">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </div>
                </div>

                <!-- Domain Row (Static & Edit in-place matching account.ejs) -->
                <div id="domain-display" class="<%= isEditing ? 'hidden' : 'flex' %> items-center gap-2 mt-1 flex-wrap">
                  <span class="text-xs font-mono font-semibold text-slate-600 dark:text-slate-300"><%= client.domain %></span>
                  <% if (client.domain === 'localhost') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30" title="Local development only">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                      Localhost (Dev only)
                    </span>
                  <% } else if (isVercelDomain) { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-indigo-100 dark:bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 border border-indigo-300/30" title="Vercel development domain (No DNS TXT verification needed in dev)">
                      <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 1155 1000">
                        <path d="m577.3 0 577.4 1000H0z"/>
                      </svg>
                      Vercel (Dev only)
                    </span>
                  <% } else if (client.environment === 'production' && client.domainStatus === 'VERIFIED') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/30">
                      <svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      Verified
                    </span>
                  <% } else if (client.domainStatus === 'VERIFIED') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                      Verified (Dev)
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30" title="DNS TXT verification required for production & custom callbacks">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                      Unverified
                    </span>
                  <% } %>

                  <% if (client.avatar) { %>
                    <button type="button" id="trigger-remove-avatar-btn" class="text-[10px] font-semibold text-rose-500 hover:text-rose-600 hover:underline cursor-pointer inline-flex items-center ml-1" title="Remove Client Logo">
                      <span>Remove Logo</span>
                    </button>
                  <% } %>
                </div>

                <div id="domain-input-wrapper" class="<%= isEditing ? 'flex' : 'hidden' %> items-center gap-2 mt-1 max-w-sm">
                  <div class="relative group/domain flex-1">
                    <input type="text" id="edit-domain" name="domain" value="<%= client.domain ? client.domain.replace(/^https?:\/\//i, '').replace(/\/+$/, '') : '' %>" required class="w-full text-xs font-mono font-bold text-slate-800 dark:text-slate-200 bg-transparent border-b border-dashed border-slate-300 dark:border-slate-700 focus:border-brand-orange focus:outline-none transition-colors pr-6 py-0.5" placeholder="e.g. xyz.com or localhost" />
                    <div class="absolute right-0 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 opacity-40 group-hover/domain:opacity-100 transition-opacity pointer-events-none">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Actions - Normal State (Matching account.ejs) -->
            <div id="normal-actions" class="<%= isEditing ? 'hidden' : 'flex' %> items-center">
              <a id="edit-details-btn" href="/client/<%= client.id %>?edit=true" class="btn-outline-sky !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center gap-1.5 transition-all duration-350 cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <span>Edit App Info</span>
              </a>
            </div>

            <!-- Actions - Editing State (Matching account.ejs) -->
            <div id="edit-actions" class="<%= isEditing ? 'flex' : 'hidden' %> items-center gap-2 transition-all duration-300">
              <button id="save-details-btn" type="submit" class="btn-outline-sky !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center gap-1.5 transition-all duration-350 cursor-pointer">
                <!-- Default Icon -->
                <svg id="save-btn-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <!-- Spinner Icon -->
                <svg id="save-btn-spinner" class="hidden w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span id="save-btn-text">Save</span>
              </button>
              <a id="cancel-details-btn" href="/client/<%= client.id %>" class="btn-outline-gray !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center gap-1.5 transition-all duration-350 cursor-pointer">
                Cancel
              </a>
            </div>
          </div>
        </form>

        <!-- Domain Verification / Localhost Notice Card -->
        <% if (client.domain === 'localhost') { %>
        <div class="mb-6 p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300 space-y-3">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-sky-500/10 dark:bg-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Localhost Development Mode</h3>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300 border border-sky-300/30">
                    Local Only
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                  This client is configured with <code class="px-1.5 py-0.5 rounded bg-white dark:bg-[#050811] text-xs font-mono font-bold text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-slate-800/80">localhost</code>. You can test authorization flows using local callback URIs (<code class="font-mono">http://localhost:*</code> or <code class="font-mono">http://127.0.0.1:*</code>).
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
                  When you're ready to deploy or switch to <span class="font-semibold text-slate-700 dark:text-slate-300">Production</span>, click <a href="/client/<%= client.id %>?edit=true&target=domain" class="add-real-domain-link font-semibold text-brand-orange hover:underline cursor-pointer">Edit App Info</a> above to set your custom domain and verify DNS ownership.
                </p>
              </div>
            </div>
          </div>
        </div>
        <% } else if (isVercelDomain) { %>
        <div class="mb-6 p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300 space-y-3">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 1155 1000">
                  <path d="m577.3 0 577.4 1000H0z"/>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Vercel Development Mode</h3>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase bg-indigo-100 dark:bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 border border-indigo-300/30">
                    Dev Mode Only
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                  This client is configured with <code class="px-1.5 py-0.5 rounded bg-white dark:bg-[#050811] text-xs font-mono font-bold text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-slate-800/80"><%= client.domain %></code>. Development Vercel domains are active immediately without DNS TXT verification. You can configure callback URIs using this domain and test authorization flows directly.
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
                  <span class="font-bold text-slate-700 dark:text-slate-300">Production note:</span> Switching to <span class="font-semibold text-slate-700 dark:text-slate-300">Production</span> requires a verified custom domain. Unverified Vercel domains cannot be switched to production.
                </p>
              </div>
            </div>
          </div>
        </div>
        <% } else if (client.domainStatus !== 'VERIFIED') { %>
        <div class="mb-6 p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300 space-y-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Domain Ownership Verification</h3>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/40 dark:border-amber-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    Verification Required
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                  Verify control of <span class="font-bold font-mono text-slate-800 dark:text-slate-200"><%= client.domain %></span> by adding this DNS TXT record with your DNS provider. Required before using custom domain callbacks or switching to Production.
                </p>
              </div>
            </div>

            <form action="/client/<%= client.id %>/domain/verify" method="POST" class="shrink-0">
              <button type="submit" class="btn-orange !py-2 !px-4 !text-xs font-bold rounded-xl shadow-sm hover:shadow-brand-orange/20 cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Verify Domain
              </button>
            </form>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-3 pt-4 border-t border-slate-200/80 dark:border-slate-800/80">
            <!-- Record Type -->
            <div class="md:col-span-3 p-3.5 rounded-xl bg-white dark:bg-[#050811] border border-slate-200/80 dark:border-slate-800/80 shadow-2xs">
              <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Record Type</p>
              <p class="text-xs font-mono font-extrabold text-slate-800 dark:text-slate-200 mt-1">TXT</p>
            </div>

            <!-- Host / Name -->
            <div class="md:col-span-4 p-3.5 rounded-xl bg-white dark:bg-[#050811] border border-slate-200/80 dark:border-slate-800/80 shadow-2xs">
              <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Host / Name</p>
                <button type="button" class="copy-btn text-[10px] font-bold text-brand-orange hover:underline cursor-pointer" data-copy-target="txt-host">
                  <span class="copy-btn-label">Copy</span>
                </button>
              </div>
              <input id="txt-host" type="text" readonly value="_pramaan-verification" class="w-full text-xs font-mono font-extrabold text-slate-800 dark:text-slate-200 mt-1 bg-transparent focus:outline-none" />
              <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 truncate">Resolves to: _pramaan-verification.<%= client.domain %></p>
            </div>

            <!-- Record Value -->
            <div class="md:col-span-5 p-3.5 rounded-xl bg-white dark:bg-[#050811] border border-slate-200/80 dark:border-slate-800/80 shadow-2xs">
              <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Record Value</p>
                <button type="button" class="copy-btn text-[10px] font-bold text-brand-orange hover:underline cursor-pointer" data-copy-target="txt-val">
                  <span class="copy-btn-label">Copy</span>
                </button>
              </div>
              <input id="txt-val" type="text" readonly value="pramaan-verification=<%= client.domainVerificationToken %>" class="w-full text-xs font-mono font-extrabold text-slate-800 dark:text-slate-200 mt-1 bg-transparent focus:outline-none truncate" />
              <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">Exact verification token</p>
            </div>
          </div>

          <div class="flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
            <span class="text-xs">💡</span>
            <span>DNS changes can take 1 to 5 minutes to propagate depending on your DNS registrar.</span>
          </div>
        </div>
        <% } %>

        <div class="space-y-4">
          <!-- Client ID -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20">
            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Client ID</p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <input id="client-id" type="text" readonly value="<%= client.id %>" class="flex-1 text-xs font-mono bg-white dark:bg-[#050811] text-slate-700 dark:text-slate-200 px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800/80 focus:outline-none" />
              <button type="button" class="copy-btn shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-bold text-white dark:text-slate-200 bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 dark:hover:bg-slate-600 focus:outline-none transition-all cursor-pointer rounded-xl" data-copy-target="client-id">
                <span class="copy-btn-label">Copy ID</span>
              </button>
            </div>
          </div>

          <div class="bg-sky-50/70 dark:bg-sky-500/10 border border-sky-200 dark:border-sky-500/30 rounded-2xl p-4 flex items-center gap-3 shadow-xs">
            <span class="text-base shrink-0 select-none flex items-center justify-center">💡</span>
            <p class="text-xs text-sky-900 dark:text-sky-300 font-medium leading-relaxed">
              Use this <span class="font-extrabold">Client ID</span> in your client integration headers to authorize users. It uniquely identifies your client app.
            </p>
          </div>
        </div>
      </section>

      <!-- Security Section -->
      <section class="dashboard-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon bg-brand-orange">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Security Credentials</h2>
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Configure authentication profiles and keys.</p>
          </div>
        </div>

        <div class="space-y-6">
          <!-- Client Type -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">Client Type</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase
              <%= client.clientType?.toLowerCase() === 'confidential'
                ? 'bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300 border border-sky-300/30'
                : 'bg-purple-100 dark:bg-purple-500/20 text-purple-700 dark:text-purple-300 border border-purple-300/30' %>">
                    <%= client.clientType %>
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  Confidential clients can keep secrets secure on their backend. Public clients run in the browser or mobile devices and do not use secrets.
                </p>
              </div>

              <form action="/client/<%= client.id %>/type" method="POST" class="shrink-0">
                <input type="hidden" name="client_type" value="<%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'PUBLIC' : 'CONFIDENTIAL' %>" />
                <button type="submit" class="btn-outline-orange text-xs py-2 px-3.5 cursor-pointer">
                  Switch to <%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'Public' : 'Confidential' %>
                </button>
              </form>
            </div>
          </div>

          <!-- PKCE -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div>
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">PKCE Enforcement</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold
              <%= client.enforcePKCE 
                ? 'bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/30' 
                : 'bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30' %>">
                    <%= client.enforcePKCE ? 'Enforced' : 'Optional' %>
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  PKCE prevents authorization code hijacking. Highly recommended for SPAs and mobile applications.
                </p>
              </div>
            </div>
          </div>

          <!-- Environment -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex items-start justify-between gap-6 flex-wrap">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">Policy Environment</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase
              <%= client.environment === "production"
                ? "bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/30"
                : "bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30" %>">
                    <%= client.environment %>
                  </span>
                </div>
              <% if (client.environment === "development") { %>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                Development mode allows localhost callbacks and Vercel development domains without DNS verification.
              </p>
              <% } else { %>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                Production mode strictly enforces secure HTTPS for all callback redirects to your verified custom domain.
              </p>
              <% } %>
            </div>
            <% if (client.environment === "development") { %>
              <% if (isVercelDomain) { %>
              <div class="flex flex-col items-center gap-1.5 shrink-0">
                <button type="button" disabled class="btn-outline-gray opacity-50 cursor-not-allowed text-xs py-2 px-4 block text-center" title="Vercel domains (*.vercel.app) are development only. Configure and verify a custom domain to enable Production.">
                  Switch to Production
                </button>
                <span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 text-center">Requires custom domain</span>
              </div>
              <% } else if (client.domainStatus === "VERIFIED") { %>
              <a href="/client/<%= client.id %>/environment?environment=production" class="btn-outline-orange text-xs py-2 px-4 shrink-0 block text-center">
                Switch to Production
              </a>
              <% } else { %>
              <div class="flex flex-col items-center gap-1.5 shrink-0">
                <button type="button" disabled class="btn-outline-gray opacity-50 cursor-not-allowed text-xs py-2 px-4 block text-center" title="Verify domain ownership via DNS TXT record first">
                  Switch to Production
                </button>
                <span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 text-center">Requires verified domain</span>
              </div>
              <% } %>
            <% } else { %>
            <a href="/client/<%= client.id %>/environment?environment=development" class="btn-outline-orange text-xs py-2 px-4 shrink-0 block text-center">
              Switch to Development
            </a>
            <% } %>
          </div>
          </div>

          <!-- Client Secret -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">Client Secret</p>
                  <% if (client.client_secret) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30">
                    Revealed once
                  </span>
                  <% } %>
                </div>

                <% if (!client.client_secret) { %>
                <form action="/client/rotate-secret" method="POST">
                  <input type="hidden" name="client_id" value="<%= client.id %>" />
                  <button type="submit" class="btn-outline-sky text-xs py-2 px-4 cursor-pointer">
                    Create New Key
                  </button>
                </form>
                <% } %>
              </div>
              
              <% if (client.client_secret) { %>
              <div class="rounded-2xl bg-amber-50/70 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/30 p-4 shadow-xs">
                <p class="text-xs font-bold text-amber-900 dark:text-amber-300">⚠️ Secure storage required</p>
                <p class="text-[11px] text-amber-800 dark:text-amber-200 leading-normal mt-0.5">This secret is displayed only once. If you reload this page or close this tab, it will be hidden. Save it securely on your servers.</p>
              </div>

              <div class="flex flex-col sm:flex-row gap-2">
                <div class="flex items-center gap-2 flex-1 bg-white dark:bg-[#050811] rounded-xl px-3.5 py-2.5 border border-slate-200 dark:border-slate-800/80 shadow-xs">
                  <input id="client-secret" type="text" readonly value="<%= client.client_secret %>" class="flex-1 font-mono text-xs text-slate-800 dark:text-slate-200 bg-transparent focus:outline-none" />
                  <button type="button" class="copy-btn text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer" data-copy-target="client-secret">
                    <span class="copy-btn-label">Copy Secret</span>
                  </button>
                </div>
              </div>
              <% } else { %>
              <div class="rounded-2xl bg-slate-200/40 dark:bg-[#050811]/60 border border-slate-200/80 dark:border-slate-800/80 p-4 shadow-xs">
                <p class="text-xs font-bold text-slate-800 dark:text-slate-200">No active secret visible</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-normal mt-0.5">Secrets are hashed and stored securely. Click "Create New Key" above if you need to generate a new client secret for confidential flows.</p>
              </div>
              <% } %>
            </div>
          </div>

        </div>
      </section>

      <!-- Redirect URIs Section -->
      <section class="dashboard-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon bg-emerald-500">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Redirect URIs</h2>
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Manage authorized domains and callback paths.</p>
          </div>
        </div>

        <% if (client.redirectURIs.length === 0) { %>
        <div class="text-center py-10 px-4 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800/80 bg-slate-50/40 dark:bg-[#070b14]/40 mb-6">
          <svg class="w-10 h-10 text-slate-300 dark:text-slate-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-slate-700 dark:text-slate-200 font-bold text-sm">No redirects registered</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">You must register at least one URI to accept OAuth code requests.</p>
        </div>
        <% } else { %>
        <div class="space-y-2 mb-6">
          <% for (const uri of client.redirectURIs) { %>
          <div class="flex items-center justify-between gap-4 p-3.5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-colors">
            <code class="font-mono text-xs text-slate-700 dark:text-slate-200 truncate select-all">
              <%= uri %>
            </code>
            <form method="POST" action="/client/<%= client.id %>/ruri" class="shrink-0">
              <input type="hidden" name="action" value="del" />
              <input type="hidden" name="redirect_uri" value="<%= uri %>" />
              <button type="submit" class="p-2 rounded-xl text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 hover:text-rose-600 dark:hover:text-rose-400 transition-colors cursor-pointer" title="Remove URI">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m5 5v6m4-6v6" />
                </svg>
              </button>
            </form>
          </div>
          <% } %>
        </div>
        <% } %>

        <!-- Add URI Form -->
        <div class="p-5 rounded-2xl bg-orange-50/20 dark:bg-[#070b14]/80 border border-brand-orange/30 dark:border-brand-orange/30 shadow-xs">
          <form method="POST" action="/client/<%= client.id %>/ruri" class="space-y-3">
            <input type="hidden" name="action" value="add" />

            <div class="flex flex-col sm:flex-row gap-3">
              <input name="redirect_uri" type="url" required placeholder="<%= client.environment === 'development' && (client.domain === 'localhost' || (!isVercelDomain && client.domainStatus !== 'VERIFIED')) ? 'http://localhost:3000/oauth/callback' : 'https://' + client.domain + '/oauth/callback' %>" class="input-field shadow-xs">
              <button type="submit" class="btn-orange !py-3 !px-5 !text-xs shrink-0 font-bold">
                Add URI
              </button>
            </div>
            
            <% if (client.environment === 'development') { %>
              <% if (isVercelDomain) { %>
              <p class="text-[11px] text-emerald-700 dark:text-emerald-400 leading-normal font-semibold">
                Development Vercel domain. You can use <span class="font-mono">localhost</span>, <span class="font-mono">127.0.0.1</span>, <span class="font-mono"><%= client.domain %></span>, or <span class="font-mono">*.vercel.app</span> callbacks without DNS verification.
              </p>
              <% } else if (client.domainStatus === 'VERIFIED') { %>
              <p class="text-[11px] text-emerald-700 dark:text-emerald-400 leading-normal font-semibold">
                You can use <span class="font-mono">localhost</span>, <span class="font-mono">127.0.0.1</span>, <span class="font-mono"><%= client.domain %></span>, or <span class="font-mono">*.vercel.app</span> callbacks.
              </p>
              <% } else { %>
              <p class="text-[11px] text-amber-900/90 dark:text-brand-orange/90 leading-normal font-semibold">
                In development mode: only <span class="font-mono">localhost</span>, <span class="font-mono">127.0.0.1</span>, or <span class="font-mono">*.vercel.app</span> callbacks are allowed until domain <span class="font-mono"><%= client.domain %></span> is verified via DNS TXT record.
              </p>
              <% } %>
            <% } else { %>
            <p class="text-[11px] text-amber-900/90 dark:text-brand-orange/90 leading-normal font-semibold">
              In production mode: callbacks must use secure <span class="font-mono">https://</span> and match your verified custom domain <span class="font-mono"><%= client.domain %></span>.
            </p>
            <% } %>
          </form>
        </div>
      </section>

    </div>

    <!-- Metadata & Danger (Right) -->
    <div class="lg:col-span-1 space-y-8">
      
      <!-- Metadata Section -->
      <section class="dashboard-section !p-6">
        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800/80 pb-4">
          <div class="dashboard-icon bg-sky-500 !shadow-none">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Metadata</h2>
            <p class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">System attributes</p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Created</p>
            <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= createdAtFormatted %></p>
          </div>

          <div class="pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Last Updated</p>
            <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= updatedAtFormatted %></p>
          </div>

          <% if (client.revokedAt) { %>
          <div class="pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <p class="text-[10px] font-bold uppercase tracking-wider text-red-500 dark:text-rose-400 mb-1">Revoked</p>
            <p class="text-xs font-bold text-red-700 dark:text-rose-300"><%= revokedAtFormatted %></p>
          </div>
          <% } %>
        </div>

        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-4 leading-normal">System attributes are read-only metadata records generated during lifecycle updates.</p>
      </section>

      <!-- Danger Zone -->
      <section class="dashboard-danger-section">
        <div class="flex items-center gap-3 mb-6 border-b border-red-200/40 dark:border-rose-950/60 pb-4">
          <div class="dashboard-icon bg-rose-500">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Danger Zone</h2>
            <p class="text-[10px] font-semibold text-red-500/90 dark:text-rose-400">Client lifecycle actions</p>
          </div>
        </div>

        <div class="space-y-4">
          <!-- Toggle Active Status -->
          <div class="p-4 bg-white dark:bg-[#070b14]/80 border border-slate-200 dark:border-slate-800/80 rounded-2xl flex flex-col justify-between gap-3 shadow-xs dark:shadow-black/20">
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-slate-100">
                <%= client.isActive ? "Disable Client" : "Activate Client" %>
              </p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-normal">
                <%= client.isActive 
                  ? "Prevent this client configuration from validating any OAuth code flow requests." 
                  : "Restore code authentication validation capacity." %>
              </p>
            </div>

            <% if (client.isActive) { %>
            <a href="/client/<%= client.id %>/deactivate?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-rose text-xs py-2 w-full text-center block">
              Disable
            </a>
            <% } else { %>
            <a href="/client/<%= client.id %>/activate?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-green text-xs py-2 w-full text-center block">
              Activate
            </a>
            <% } %>
          </div>

          <!-- Permanent Delete -->
          <div class="p-4 bg-white dark:bg-[#070b14]/80 border border-rose-200 dark:border-rose-900/40 rounded-2xl flex flex-col justify-between gap-3 shadow-xs dark:shadow-black/20">
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-slate-100">Delete Client</p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-normal">Permanently remove credentials, secrets, callback records, and active keys. This cannot be undone.</p>
            </div>
            <a href="/client/<%= client.id %>/delete?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-rose text-xs py-2 w-full text-center block">
              Delete Client
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>

</div>

<script src="/js/copyBtn.js" defer></script>
<script src="/js/client-dashboard.js" defer></script>