<% layout("layouts/main") %>

<%
  const _variant = typeof variant !== 'undefined' ? variant : 'default'; // default | success | warning | danger | info
  const _size = typeof size !== 'undefined' ? size : 'md'; // sm | md
  const _text = typeof text !== 'undefined' ? text : '';

  const _renderPartial = typeof include === 'function'
      ? include
      : (typeof partial === 'function' ? partial : null);

  const variantClasses = {
    default: 'bg-slate-100 dark:bg-slate-800/40 text-slate-700 dark:text-slate-400',
    success: 'bg-green-100 dark:bg-emerald-500/10 text-green-700 dark:text-emerald-400 ring-1 ring-green-200 dark:ring-emerald-500/20',
    warning: 'bg-amber-100 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 ring-1 ring-amber-200 dark:ring-amber-500/20',
    danger: 'bg-red-100 dark:bg-rose-500/10 text-red-700 dark:text-rose-400 ring-1 ring-red-200 dark:ring-rose-500/20',
    info: 'bg-sky-100 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 ring-1 ring-sky-200 dark:ring-sky-500/20'
  };
%>

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8 animate-slideIn relative z-10">

  <!-- Back Button -->
  <div class="flex">
    <a href="/account" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-brand-orange transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Dashboard
    </a>
  </div>

  <!-- Page Header -->
  <div class="border-b border-slate-200/40 dark:border-slate-800/40 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">Client Dashboard</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Configure client details, secrets, environments, and authorization URLs.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <!-- Theme Switch Button -->
      <button id="themeToggle" class="btn-outline-gray !py-2 !px-4 !text-xs shrink-0 flex items-center justify-center gap-2">
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span class="hidden dark:block">Light Mode</span>
        <span class="block dark:hidden">Dark Mode</span>
      </button>

      <span class="inline-flex items-center font-bold rounded-full px-3.5 py-1.5 text-xs <%= variantClasses[client.isActive ? "success" : "default"] %>">
        <span class="w-1.5 h-1.5 rounded-full <%= client.isActive ? 'bg-green-500' : 'bg-slate-400' %> mr-1.5 animate-pulse"></span>
        <%= client.isActive ? "Active" : "Disabled" %>
      </span>
    </div>
  </div>

  <%
    const _warning = typeof warning !== 'undefined' ? warning : undefined;
  %>
  <% if (_renderPartial) { %>
  <%- _renderPartial("../../../partials/alert", { success, error, warning: _warning }) %>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Overview & Configuration (Left) -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- App Overview -->
      <section class="dashboard-section">
        <div class="flex items-start sm:items-center justify-between gap-4 mb-6 flex-wrap">
          <div class="flex items-start sm:items-center gap-4">
            <div class="dashboard-icon bg-slate-900 dark:bg-slate-200">
              <svg class="w-6 h-6 text-white dark:text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <div id="overview-static" class="min-w-0">
              <h2 class="text-2xl font-extrabold text-slate-900 dark:text-slate-100 truncate"><%= client.name %></h2>
              <% if (client.domain) { %>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold tracking-wide lowercase mt-0.5"><%= client.domain %></p>
              <% } %>
            </div>
          </div>

          <button id="edit-details-btn" type="button" class="btn-outline-sky !py-1.5 !px-3.5 !text-xs rounded-xl inline-flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Edit App Info</span>
          </button>
        </div>

        <!-- Inline Edit Form (Hidden by default) -->
        <form id="edit-details-form" action="/client/<%= client.id %>/settings" method="POST" class="hidden mb-6 p-4 rounded-2xl bg-slate-100/70 dark:bg-[#0c1222] border border-slate-200 dark:border-slate-800 space-y-3.5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="edit-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Client Name</label>
              <input type="text" id="edit-name" name="name" value="<%= client.name %>" required class="input-field text-xs py-2 px-3" placeholder="App Name" />
            </div>
            <div>
              <label for="edit-domain" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Registered Domain</label>
              <input type="text" id="edit-domain" name="domain" value="<%= client.domain %>" required class="input-field text-xs py-2 px-3 font-mono" placeholder="xyz.com" />
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 pt-1">
            <button type="button" id="cancel-edit-details-btn" class="btn-outline-gray !py-1.5 !px-3 !text-xs rounded-lg cursor-pointer">
              Cancel
            </button>
            <button type="submit" class="btn-orange !py-1.5 !px-4 !text-xs font-bold rounded-lg cursor-pointer shadow-sm">
              Save Changes
            </button>
          </div>
        </form>

        <div class="space-y-4">
          <!-- Client ID -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20">
            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Client ID</p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <input id="client-id" type="text" readonly value="<%= client.id %>" class="flex-1 text-xs font-mono bg-white dark:bg-[#050811] text-slate-700 dark:text-slate-200 px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800/80 focus:outline-none" />
              <button type="button" class="copy-btn shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-bold text-white dark:text-slate-200 bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 dark:hover:bg-slate-600 focus:outline-none transition-all cursor-pointer rounded-xl" data-copy-target="client-id">
                <span class="copy-btn-label">Copy ID</span>
              </button>
            </div>
          </div>

          <div class="bg-sky-50/70 dark:bg-sky-500/10 border border-sky-200 dark:border-sky-500/30 rounded-2xl p-4 flex items-center gap-3 shadow-xs">
            <span class="text-base shrink-0 select-none flex items-center justify-center">💡</span>
            <p class="text-xs text-sky-900 dark:text-sky-300 font-medium leading-relaxed">
              Use this <span class="font-extrabold">Client ID</span> in your client integration headers to authorize users. It uniquely identifies your client app.
            </p>
          </div>
        </div>
      </section>

      <!-- Security Section -->
      <section class="dashboard-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon bg-brand-orange">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Security Credentials</h2>
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Configure authentication profiles and keys.</p>
          </div>
        </div>

        <div class="space-y-6">
          <!-- Client Type -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">Client Type</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase
              <%= client.clientType?.toLowerCase() === 'confidential'
                ? 'bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300 border border-sky-300/30'
                : 'bg-purple-100 dark:bg-purple-500/20 text-purple-700 dark:text-purple-300 border border-purple-300/30' %>">
                    <%= client.clientType %>
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  Confidential clients can keep secrets secure on their backend. Public clients run in the browser or mobile devices and do not use secrets.
                </p>
              </div>

              <form action="/client/<%= client.id %>/type" method="POST" class="shrink-0">
                <input type="hidden" name="client_type" value="<%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'PUBLIC' : 'CONFIDENTIAL' %>" />
                <button type="submit" class="btn-outline-orange text-xs py-2 px-3.5 cursor-pointer">
                  Switch to <%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'Public' : 'Confidential' %>
                </button>
              </form>
            </div>
          </div>

          <!-- PKCE -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div>
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">PKCE Enforcement</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold
              <%= client.enforcePKCE 
                ? 'bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/30' 
                : 'bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30' %>">
                    <%= client.enforcePKCE ? 'Enforced' : 'Optional' %>
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  PKCE prevents authorization code hijacking. Highly recommended for SPAs and mobile applications.
                </p>
              </div>
            </div>
          </div>

          <!-- Environment -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex items-start justify-between gap-6 flex-wrap">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">Policy Environment</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase
              <%= client.environment === "production"
                ? "bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/30"
                : "bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30" %>">
                    <%= client.environment %>
                  </span>
                </div>
                <% if (client.environment === "development") { %>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  Development mode allows localhost test domains to utilize insecure HTTP callbacks.
                </p>
                <% } else { %>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  Production mode strictly enforces secure HTTPS for all callback redirects.
                </p>
                <% } %>
              </div>
              <a href="/client/<%= client.id %>/environment?environment=<%= client.environment === 'development' ? 'production' : 'development' %>" class="btn-outline-orange text-xs py-2 px-4 shrink-0 block text-center">
                Switch to <%= client.environment === "development" ? "Production" : "Development" %>
              </a>
            </div>
          </div>

          <!-- Client Secret -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-all duration-300">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-2.5">
                  <p class="text-sm font-bold text-slate-800 dark:text-slate-200">Client Secret</p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold
                    <%= client.client_secret 
                      ? 'bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30' 
                      : 'bg-slate-200 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300' %>">
                    <%= client.client_secret ? 'Revealed once' : 'Protected / Rotated' %>
                  </span>
                </div>

                <% if (!client.client_secret) { %>
                <form action="/client/rotate-secret" method="POST">
                  <input type="hidden" name="client_id" value="<%= client.id %>" />
                  <button type="submit" class="btn-outline-sky text-xs py-2 px-4 cursor-pointer">
                    Generate Secret
                  </button>
                </form>
                <% } %>
              </div>
              
              <% if (client.client_secret) { %>
              <div class="rounded-2xl bg-amber-50/70 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/30 p-4 shadow-xs">
                <p class="text-xs font-bold text-amber-900 dark:text-amber-300">⚠️ Secure storage required</p>
                <p class="text-[11px] text-amber-800 dark:text-amber-200 leading-normal mt-0.5">This secret is displayed only once. If you reload this page or close this tab, it will be hidden. Save it securely on your servers.</p>
              </div>

              <div class="flex flex-col sm:flex-row gap-2">
                <div class="flex items-center gap-2 flex-1 bg-white dark:bg-[#050811] rounded-xl px-3.5 py-2.5 border border-slate-200 dark:border-slate-800/80 shadow-xs">
                  <input id="client-secret" type="text" readonly value="<%= client.client_secret %>" class="flex-1 font-mono text-xs text-slate-800 dark:text-slate-200 bg-transparent focus:outline-none" />
                  <button type="button" class="copy-btn text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer" data-copy-target="client-secret">
                    <span class="copy-btn-label">Copy Secret</span>
                  </button>
                </div>
              </div>
              <% } else { %>
              <div class="rounded-2xl bg-slate-200/40 dark:bg-[#050811]/60 border border-slate-200/80 dark:border-slate-800/80 p-4 shadow-xs">
                <p class="text-xs font-bold text-slate-800 dark:text-slate-200">No active secret visible</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-normal mt-0.5">Secrets are protected on client endpoints. Generate or rotate your key below if you need a new credential for confidential flows.</p>
                
                <form action="/client/rotate-secret" method="POST" class="mt-3">
                  <input type="hidden" name="client_id" value="<%= client.id %>" />
                  <button type="submit" class="btn-outline-sky text-xs py-2 px-4 cursor-pointer">
                    Rotate Secret Key
                  </button>
                </form>
              </div>
              <% } %>
            </div>
          </div>

        </div>
      </section>

      <!-- Redirect URIs Section -->
      <section class="dashboard-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon bg-emerald-500">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Redirect URIs</h2>
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Manage authorized domains and callback paths.</p>
          </div>
        </div>

        <% if (client.redirectURIs.length === 0) { %>
        <div class="text-center py-10 px-4 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800/80 bg-slate-50/40 dark:bg-[#070b14]/40 mb-6">
          <svg class="w-10 h-10 text-slate-300 dark:text-slate-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-slate-700 dark:text-slate-200 font-bold text-sm">No redirects registered</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">You must register at least one URI to accept OAuth code requests.</p>
        </div>
        <% } else { %>
        <div class="space-y-2 mb-6">
          <% for (const uri of client.redirectURIs) { %>
          <div class="flex items-center justify-between gap-4 p-3.5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-slate-350 dark:hover:border-slate-700 transition-colors">
            <code class="font-mono text-xs text-slate-700 dark:text-slate-200 truncate select-all">
              <%= uri %>
            </code>
            <form method="POST" action="/client/<%= client.id %>/ruri" class="shrink-0">
              <input type="hidden" name="action" value="del" />
              <input type="hidden" name="redirect_uri" value="<%= uri %>" />
              <button type="submit" class="p-2 rounded-xl text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 hover:text-rose-600 dark:hover:text-rose-400 transition-colors cursor-pointer" title="Remove URI">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m5 5v6m4-6v6" />
                </svg>
              </button>
            </form>
          </div>
          <% } %>
        </div>
        <% } %>

        <!-- Add URI Form -->
        <div class="p-5 rounded-2xl bg-orange-50/20 dark:bg-[#070b14]/80 border border-brand-orange/30 dark:border-brand-orange/30 shadow-xs">
          <form method="POST" action="/client/<%= client.id %>/ruri" class="space-y-3">
            <input type="hidden" name="action" value="add" />

            <div class="flex flex-col sm:flex-row gap-3">
              <input name="redirect_uri" type="url" required placeholder="https://myapp.com/oauth/callback" class="input-field shadow-xs">
              <button type="submit" class="btn-orange !py-3 !px-5 !text-xs shrink-0 font-bold">
                Add URI
              </button>
            </div>
            
            <p class="text-[11px] text-amber-900/90 dark:text-brand-orange/90 leading-normal font-semibold">
              ⚠️ Callback URLs must exactly match parameter values and conform to secure protocol policies.
            </p>
          </form>
        </div>
      </section>

    </div>

    <!-- Metadata & Danger (Right) -->
    <div class="lg:col-span-1 space-y-8">
      
      <!-- Metadata Section -->
      <section class="dashboard-section !p-6">
        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800/80 pb-4">
          <div class="dashboard-icon bg-sky-500 !shadow-none">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Metadata</h2>
            <p class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">System attributes</p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Created</p>
            <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= createdAtFormatted %></p>
          </div>

          <div class="pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Last Updated</p>
            <p class="text-xs font-bold text-slate-700 dark:text-slate-200"><%= updatedAtFormatted %></p>
          </div>

          <% if (client.revokedAt) { %>
          <div class="pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <p class="text-[10px] font-bold uppercase tracking-wider text-red-500 dark:text-rose-400 mb-1">Revoked</p>
            <p class="text-xs font-bold text-red-700 dark:text-rose-300"><%= revokedAtFormatted %></p>
          </div>
          <% } %>
        </div>

        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-4 leading-normal">System attributes are read-only metadata records generated during lifecycle updates.</p>
      </section>

      <!-- Danger Zone -->
      <section class="dashboard-danger-section">
        <div class="flex items-center gap-3 mb-6 border-b border-red-200/40 dark:border-rose-950/60 pb-4">
          <div class="dashboard-icon bg-rose-500">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Danger Zone</h2>
            <p class="text-[10px] font-semibold text-red-500/90 dark:text-rose-400">Client lifecycle actions</p>
          </div>
        </div>

        <div class="space-y-4">
          <!-- Toggle Active Status -->
          <div class="p-4 bg-white dark:bg-[#070b14]/80 border border-slate-200 dark:border-slate-800/80 rounded-2xl flex flex-col justify-between gap-3 shadow-xs dark:shadow-black/20">
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-slate-100">
                <%= client.isActive ? "Disable Client" : "Activate Client" %>
              </p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-normal">
                <%= client.isActive 
                  ? "Prevent this client configuration from validating any OAuth code flow requests." 
                  : "Restore code authentication validation capacity." %>
              </p>
            </div>

            <% if (client.isActive) { %>
            <a href="/client/<%= client.id %>/deactivate?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-rose text-xs py-2 w-full text-center block">
              Disable
            </a>
            <% } else { %>
            <a href="/client/<%= client.id %>/activate?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-green text-xs py-2 w-full text-center block">
              Activate
            </a>
            <% } %>
          </div>

          <!-- Permanent Delete -->
          <div class="p-4 bg-white dark:bg-[#070b14]/80 border border-rose-200 dark:border-rose-900/40 rounded-2xl flex flex-col justify-between gap-3 shadow-xs dark:shadow-black/20">
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-slate-100">Delete Client</p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-normal">Permanently remove credentials, secrets, callback records, and active keys. This cannot be undone.</p>
            </div>
            <a href="/client/<%= client.id %>/delete?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-rose text-xs py-2 w-full text-center block">
              Delete Client
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>

</div>

<script src="/js/copyBtn.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const editBtn = document.getElementById('edit-details-btn');
    const form = document.getElementById('edit-details-form');
    const cancelBtn = document.getElementById('cancel-edit-details-btn');

    if (editBtn && form && cancelBtn) {
      editBtn.addEventListener('click', () => {
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) {
          document.getElementById('edit-name')?.focus();
        }
      });
      cancelBtn.addEventListener('click', () => {
        form.classList.add('hidden');
      });
    }
  });
</script>