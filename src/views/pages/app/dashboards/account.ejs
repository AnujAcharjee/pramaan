<% layout("layouts/main") %>

<%
  const _avatar = user.avatar
    ? user.avatar
    : user.gender === 'MALE'
      ? '/images/avatar-m-placeholder.jpg'
      : '/images/avatar-f-placeholder.png';
%>

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8 animate-slideIn relative z-10">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/40 dark:border-slate-800/40 pb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">Dashboard</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Manage your account credentials, security settings, and client applications.</p>
    </div>

    <!-- Theme Switch Button -->
    <button id="themeToggle" class="btn-outline-gray !py-2 !px-4 !text-xs shrink-0 flex items-center justify-center gap-2">
      <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
      </svg>
      <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
      <span class="hidden dark:block">Light Mode</span>
      <span class="block dark:hidden">Dark Mode</span>
    </button>
  </div>

  <%- include("../../../partials/alert", { success, error }) %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Profile & Security Column (Left) -->
    <div class="lg:col-span-1 space-y-8">
      
      <!-- Profile Section -->
      <section class="dashboard-section !p-6">
        <form id="profile-form" action="/account?_method=PUT" method="POST" enctype="multipart/form-data" class="flex flex-col items-center text-center">
          <!-- Avatar -->
          <div id="avatar-container" class="relative mb-4 group/avatar">
            <img id="avatar-preview" src="<%= _avatar %>" alt="<%= user.name %>" class="h-24 w-24 rounded-3xl object-cover ring-4 ring-brand-orange/20 dark:ring-brand-orange/15 shadow-md transition duration-300" />
            
            <!-- Hover/Camera Icon Overlay (Only shown when editing) -->
            <div id="avatar-edit-overlay" class="hidden absolute inset-0 items-center justify-center opacity-0 group-hover/avatar:opacity-100 transition-opacity bg-black/35 rounded-3xl cursor-pointer">
              <svg class="w-6 h-6 text-white drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>

            <!-- Drag Over Overlay -->
            <div id="drag-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-brand-orange/90 dark:bg-brand-orange/80 rounded-3xl opacity-0 pointer-events-none transition-opacity duration-300 z-20">
              <svg class="w-6 h-6 text-white animate-bounce mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span class="text-[10px] font-bold text-white uppercase tracking-wider">Drop Here</span>
            </div>

            <input id="avatar-input" type="file" name="avatar" accept="image/*" class="hidden absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
            
            <% if(user.isEmailVerified) { %>
            <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-emerald-500 rounded-full border-4 border-white dark:border-[#161a2a] flex items-center justify-center shadow-sm z-15" title="Email Verified">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <% } %>
          </div>

          <!-- Undo Button (Initially Hidden) -->
          <button id="undo-avatar-btn" type="button" class="hidden btn-outline-rose !py-1 !px-3 !text-[10px] rounded-lg mb-4 items-center gap-1 transition-all duration-300">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
            </svg>
            <span>Undo Selection</span>
          </button>

          <!-- User Info Display & Edit -->
          <div class="space-y-4 w-full min-w-0">
            <!-- Name Display (Static) -->
            <h2 id="name-display" class="text-xl font-extrabold text-slate-900 dark:text-slate-100 truncate mx-auto max-w-full">
              <%= user.name %>
            </h2>

            <!-- Name Input (Hidden by default) -->
            <div id="name-input-wrapper" class="hidden relative group/name mx-auto max-w-full">
              <input type="text" id="name-input" name="name" value="<%= user.name %>" class="w-full text-center text-xl font-extrabold text-slate-900 dark:text-slate-100 bg-transparent border-b border-dashed border-slate-300 dark:border-slate-750 focus:border-brand-orange focus:outline-none transition-colors pr-6" placeholder="Your Name" required />
              <div class="absolute right-0 top-1/2 -translate-y-1/2 text-slate-450 dark:text-slate-600 opacity-40 group-hover/name:opacity-100 transition-opacity pointer-events-none">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </div>
            </div>

            <!-- Email (Always Static) -->
            <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 truncate select-all">
              <%= user.email %>
            </p>
            
            <!-- Actions - Normal State -->
            <div id="normal-actions" class="flex items-center justify-center mt-2">
              <button id="edit-profile-btn" type="button" class="btn-outline-sky !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center gap-1.5 transition-all duration-350">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Edit Profile
              </button>
            </div>

            <!-- Actions - Editing State -->
            <div id="edit-actions" class="hidden items-center justify-center gap-2 mt-2 transition-all duration-300">
              <button id="save-profile-btn" type="submit" class="btn-outline-sky !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center gap-1.5 transition-all duration-350">
                <!-- Default Icon -->
                <svg id="save-btn-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <!-- Spinner Icon -->
                <svg id="save-btn-spinner" class="hidden w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span id="save-btn-text">Save</span>
              </button>
              <button id="cancel-profile-btn" type="button" class="btn-outline-gray !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center gap-1.5 transition-all duration-350">
                Cancel
              </button>
            </div>
            
            <div class="pt-4 border-t border-slate-100 dark:border-slate-700/50 flex items-center justify-center gap-2 text-xs font-semibold text-slate-400 dark:text-slate-400 mt-4">
              <svg class="w-4 h-4 text-slate-400 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Joined <%= createdAtFormatted %></span>
            </div>
          </div>
        </form>
      </section>

      <!-- Danger Zone -->
      <section class="dashboard-danger-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon bg-rose-500 shadow-rose-200 dark:shadow-rose-500/10">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Danger Zone</h2>
            <p class="text-xs font-semibold text-red-500/80 dark:text-rose-400/70">Irreversible actions</p>
          </div>
        </div>

        <div class="space-y-3">
          <form method="POST" action="/signout">
            <button type="submit" class="w-full text-left cursor-pointer group/btn">
              <div class="flex items-center justify-between p-3.5 rounded-2xl bg-white dark:bg-[#070b14]/80 border border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 shadow-xs dark:shadow-black/20">
                <div class="flex items-start gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-xl bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-slate-900 dark:text-slate-200">Sign out devices</p>
                    <p class="text-[10px] text-slate-400 dark:text-slate-500 truncate mt-0.5">End sessions everywhere.</p>
                  </div>
                </div>
                <svg class="w-4 h-4 text-slate-300 dark:text-slate-500 group-hover/btn:translate-x-0.5 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </button>
          </form>

          <a href="/account/delete" class="block group/btn">
            <div class="flex items-center justify-between p-3.5 rounded-2xl bg-white dark:bg-[#070b14]/80 border border-rose-100 dark:border-rose-900/40 hover:border-rose-300 dark:hover:border-rose-800/60 transition-all duration-300 shadow-xs dark:shadow-black/20">
              <div class="flex items-start gap-3 min-w-0">
                <div class="w-8 h-8 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-500 dark:text-rose-400 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4h6v3m-9 0h12" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="text-xs font-bold text-slate-900 dark:text-slate-200">Delete account</p>
                  <p class="text-[10px] text-slate-400 dark:text-slate-500 truncate mt-0.5">Permanently remove profile.</p>
                </div>
              </div>
              <svg class="w-4 h-4 text-rose-300 dark:text-rose-500/50 group-hover/btn:translate-x-0.5 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        </div>
      </section>

    </div>

    <!-- Security & Client Column (Right) -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Security Settings -->
      <section class="dashboard-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Security Settings</h2>
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-400 mt-0.5">Configure authentication factors and passwords.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Password Card -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-brand-orange/30 dark:hover:border-slate-700 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-sky-100 dark:bg-sky-500/15 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                  </svg>
                </div>
                <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm">Account Password</h3>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-350 leading-relaxed mb-4">Request a recovery link to update your secure passkey credentials.</p>
            </div>

            <div class="mt-auto">
              <% if (success === 'Password reset email sent') { %>
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-green-50 dark:bg-emerald-500/10 text-green-700 dark:text-emerald-400 border border-green-200/60 dark:border-emerald-500/20 text-xs font-semibold">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Reset email sent</span>
                </div>
                <a href="/account/change-password" class="btn-outline-sky text-xs py-2 w-full text-center">
                  Resend Link
                </a>
              </div>
              <% } else { %>
              <a href="/account/change-password" class="btn-outline-sky text-xs py-2.5 w-full text-center block">
                Reset Password
              </a>
              <% } %>
            </div>
          </div>

          <!-- MFA Card -->
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-brand-orange/30 dark:hover:border-slate-700 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl <%= user.mfaEnabled ? 'bg-emerald-100 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-400' : 'bg-slate-200 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400' %> flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </div>
                  <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm">Two-Factor (2FA)</h3>
                </div>
                <%- include("../../../partials/ui/badge", {
                  variant: user.mfaEnabled ? "success" : "default",
                  text: user.mfaEnabled ? "Active" : "Disabled",
                  size: "sm"
                }) %>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-500 leading-relaxed mb-4">Adds an extra layer of protection by requiring a dynamic token upon signing in.</p>
            </div>

            <div class="mt-auto">
              <a href="/account/<%= user.mfaEnabled ? 'mfa-disable' : 'mfa-enable' %>" class="<%= user.mfaEnabled ? 'btn-outline-rose' : 'btn-outline-green'%> text-xs py-2.5 w-full text-center block">
                <%= user.mfaEnabled ? 'Disable 2FA' : 'Enable 2FA'%>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- OAuth Consents Section -->
      <section class="dashboard-section">
        <div class="flex items-center gap-3 mb-6">
          <div class="dashboard-icon bg-sky-500 shadow-sky-200 dark:shadow-sky-500/10">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">OAuth Consents</h2>
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-400 mt-0.5">Authorizations you've granted to external integrations.</p>
          </div>
        </div>

        <% if (oauthConsents.length === 0) { %>
        <div class="text-center py-10 px-4 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800/80 bg-slate-50/40 dark:bg-[#070b14]/40">
          <svg class="w-10 h-10 text-slate-300 dark:text-slate-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-slate-600 dark:text-slate-300 font-bold text-sm">No authorized applications</p>
          <p class="text-xs text-slate-450 dark:text-slate-500 mt-0.5">Integrations authorized with Pramaan will be shown here.</p>
        </div>
        <% } else { %>
        <div class="space-y-3 max-h-80 overflow-y-auto pr-1">
          <% for (const consent of oauthConsents) { %>
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 shadow-xs dark:shadow-black/20 hover:border-brand-orange/30 dark:hover:border-slate-700 transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div class="space-y-2 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <p class="font-bold text-slate-800 dark:text-slate-100 truncate"><%= consent.client.domain %></p>
                  <%- include("../../../partials/ui/badge", {
                    variant: consent.revokedAt ? "danger" : "success",
                    text: consent.revokedAt ? "Revoked" : "Authorized",
                    size: "sm"
                  }) %>
                </div>
                
                <div class="flex flex-wrap gap-1.5">
                  <% consent.scopes.forEach(scope => { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-white dark:bg-[#050811] border border-slate-200 dark:border-slate-800/80 text-slate-700 dark:text-slate-300 text-[11px] font-semibold font-mono">
                    <%= scope %>
                  </span>
                  <% }) %>
                </div>

                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500">
                  <%= consent.revokedAt ? 'Revoked' : 'Issued' %> on <%= new Date(consent.revokedAt || consent.date).toLocaleDateString() %>
                </p>
              </div>

              <div class="shrink-0 sm:self-center">
                <% if (consent.revokedAt) { %>
                <a href="/account/reissue-consent?clientId=<%= encodeURIComponent(consent.client.id) %>&clientDomain=<%= encodeURIComponent(consent.client.domain) %>" class="btn-outline-sky text-xs py-2 px-4 block text-center">
                  Reissue
                </a>
                <% } else { %>
                <a href="/account/revoke-consent?clientId=<%= encodeURIComponent(consent.client.id) %>&clientDomain=<%= encodeURIComponent(consent.client.domain) %>" class="btn-outline-gray text-xs py-2 px-4 block text-center">
                  Revoke
                </a>
                <% } %>
              </div>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>
      </section>

      <!-- Client Registry Section -->
      <section class="dashboard-section">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
          <div class="flex items-start gap-3">
            <div class="dashboard-icon bg-slate-900 dark:bg-slate-800 border dark:border-slate-700 shadow-slate-200 dark:shadow-slate-800/10 shrink-0">
              <svg class="w-5 h-5 text-white dark:text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Developer Clients</h2>
                <%- include("../../../partials/ui/badge", {
                  variant: "warning",
                  text: "Developer Section",
                  size: "sm"
                }) %>
              </div>
              <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Manage OAuth credentials for custom application integrations.</p>
            </div>
          </div>

          <% if (clients.length !== 0) { %>
          <a href="/create-client" class="btn-orange !py-2.5 !px-4 !text-xs shrink-0 flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            <span>Register Client</span>
          </a>
          <% } %>
        </div>

        <% if (clients.length === 0) { %>
        <div class="text-center py-12 px-4 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800/80 bg-slate-50/40 dark:bg-[#070b14]/40">
          <div class="w-12 h-12 rounded-2xl bg-orange-50 dark:bg-brand-orange/15 text-brand-orange flex items-center justify-center mx-auto mb-3 shadow-xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <p class="text-slate-700 dark:text-slate-200 font-bold text-sm">No clients registered</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-5">Create your first OAuth app integration client payload.</p>
          <a href="/create-client" class="btn-orange !py-2.5 !px-5 !text-xs">
            Create Client
          </a>
        </div>
        <% } else { %>
        <div class="space-y-3">
          <% for (const client of clients) { %>
          <div class="group p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14]/80 border border-slate-200/70 dark:border-slate-800/80 hover:border-brand-orange/30 dark:hover:border-brand-orange/40 hover:bg-white dark:hover:bg-[#0e1424] hover:shadow-lg dark:hover:shadow-black/25 transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div class="space-y-3 flex-1 min-w-0">
                <div class="flex items-center gap-3 flex-wrap">
                  <h3 class="font-extrabold text-slate-900 dark:text-slate-100 text-base truncate"><%= client.name %></h3>
                  <%- include("../../../partials/ui/badge", {
                    variant: client.isActive ? "success" : "default",
                    text: client.isActive ? "Active" : "Disabled",
                    size: "sm"
                  }) %>
                </div>

                <div class="flex items-center gap-3">
                  <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 shrink-0">Client ID:</span>
                  <div class="flex items-center gap-1.5 flex-1 min-w-0">
                    <code class="text-xs font-mono text-slate-700 dark:text-slate-200 bg-white dark:bg-[#050811] border border-slate-200 dark:border-slate-800/80 px-3 py-1.5 rounded-xl truncate flex-1 block">
                      <%= client.id %>
                    </code>
                    <button type="button" class="copy-btn py-1.5 px-3 bg-white dark:bg-[#050811] border border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-600 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 transition cursor-pointer" data-copy-text="<%= client.id %>" title="Copy Client ID">
                      <span>Copy</span>
                    </button>
                  </div>
                </div>
              </div>

              <div class="shrink-0 self-start sm:self-center">
                <a href="/client/<%= client.id %>" class="btn-outline-sky text-xs py-2 px-4 block text-center">
                  Manage Settings
                </a>
              </div>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>
      </section>

    </div>
  </div>

</div>

<script src="/js/copyBtn.js" defer></script>
<script src="/js/avatar-preview.js" defer></script>