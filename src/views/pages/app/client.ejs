<% layout("layouts/dashboard") %>

<%
  activeNav = 'client';
  const _variant = typeof variant !== 'undefined' ? variant : 'default';
  const _size = typeof size !== 'undefined' ? size : 'md';
  const _text = typeof text !== 'undefined' ? text : '';

  const _renderPartial = typeof include === 'function'
      ? include
      : (typeof partial === 'function' ? partial : null);

  const variantClasses = {
    default: 'bg-slate-100 dark:bg-slate-800/40 text-slate-700 dark:text-slate-400',
    success: 'bg-green-100 dark:bg-emerald-500/10 text-green-700 dark:text-emerald-400 ring-1 ring-green-200 dark:ring-emerald-500/20',
    warning: 'bg-amber-100 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 ring-1 ring-amber-200 dark:ring-amber-500/20',
    danger: 'bg-red-100 dark:bg-rose-500/10 text-red-700 dark:text-rose-400 ring-1 ring-red-200 dark:ring-rose-500/20',
    info: 'bg-sky-100 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 ring-1 ring-sky-200 dark:ring-sky-500/20'
  };

  const isVercelDomain = Boolean(
    client.domain &&
    client.domain.trim().toLowerCase().endsWith('.vercel.app') &&
    client.domain.trim().toLowerCase().length > '.vercel.app'.length
  );

  const _warning = typeof warning !== 'undefined' ? warning : undefined;

  const _dnsInfo = typeof dnsInfo !== 'undefined' && dnsInfo
    ? dnsInfo
    : {
        host: '_pramaan-verification',
        subdomain: '',
        apex: client.domain || '',
        fqdn: `_pramaan-verification.${client.domain || ''}`
      };

  const isEditing = typeof edit !== 'undefined' && edit === true;
  const focusDomain = typeof target !== 'undefined' && target === 'domain';
  const isClientDev = client.environment === 'development' || client.domain === 'localhost';
%>

<% if (_renderPartial) { %>
<%- _renderPartial("../../partials/alert", { success, error, warning: _warning }) %>
<% } %>

<div class="max-w-5xl mx-auto py-6 sm:py-8 px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8 animate-slideIn relative z-10 pb-28">
  <script src="/js/dashboard-scroll.js" defer></script>

  <!-- ═══════════════════ 1. APP OVERVIEW SECTION ═══════════════════ -->
  <section id="overview" class="dashboard-section scroll-mt-6">
    <!-- Standalone hidden avatar forms for SSR upload and removal -->
    <form id="client-avatar-upload-form" action="/client/<%= client.id %>/avatar" method="POST" enctype="multipart/form-data" class="hidden">
      <input type="file" id="client-avatar-file-input" name="avatar" accept="image/*" class="hidden" />
    </form>
    <form id="client-remove-avatar-form" action="/client/<%= client.id %>/avatar" method="POST" class="hidden">
      <input type="hidden" name="action" value="remove" />
    </form>

    <form id="edit-details-form" action="/client/<%= client.id %>/settings" method="POST">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-200/80 dark:border-neutral-800/80">
        <div class="flex items-start sm:items-center gap-3.5 sm:gap-4 min-w-0 flex-1">
          <!-- Logo -->
          <div class="relative group/logo shrink-0">
            <label for="client-avatar-file-input" class="cursor-pointer block relative" title="Click to upload client logo">
              <div class="w-14 h-14 rounded-2xl bg-slate-200 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 shadow-sm overflow-hidden flex items-center justify-center">
                <% if (client.avatar) { %>
                  <img id="client-avatar-preview" src="<%= client.avatar %>" alt="<%= client.name %>" class="w-full h-full object-cover" />
                <% } else { %>
                  <span class="text-sm font-black tracking-wider text-slate-700 dark:text-slate-200">
                    <%= client.name.trim().slice(0, 2).toUpperCase() %>
                  </span>
                <% } %>
              </div>

              <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-brand-orange text-white flex items-center justify-center shadow-xs ring-2 ring-white dark:ring-[#0a0a0a] group-hover/logo:scale-110 transition-transform" title="Upload Logo">
                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </label>
          </div>

          <div class="min-w-0 flex-1 space-y-1">
            <!-- Name Row -->
            <h2 id="name-display" class="<%= isEditing ? 'hidden' : '' %> text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100 truncate">
              <%= client.name %>
            </h2>
            <div id="name-input-wrapper" class="<%= isEditing ? 'block' : 'hidden' %> relative group/name max-w-sm">
              <input type="text" id="edit-name" name="name" value="<%= client.name %>" required class="w-full text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100 bg-transparent border-b border-dashed border-slate-300 dark:border-slate-700 focus:border-brand-orange focus:outline-none transition-colors pr-6" placeholder="Client Name" />
            </div>

            <!-- Domain Row -->
            <div id="domain-display" class="<%= isEditing ? 'hidden' : 'flex' %> items-center gap-2 mt-1 flex-wrap">
              <span class="text-xs font-mono font-semibold text-slate-600 dark:text-slate-300 truncate"><%= client.domain %></span>
              <% if (client.domain === 'localhost') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  Localhost
                </span>
              <% } else if (isVercelDomain) { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-indigo-100 dark:bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 border border-indigo-300/30">
                  Vercel
                </span>
              <% } else if (client.domainStatus === 'VERIFIED') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Verified
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30">
                  Unverified
                </span>
              <% } %>

              <% if (!client.isActive) { %>
                <span class="inline-flex items-center font-bold rounded-full px-2 py-0.5 text-[10px] bg-slate-100 dark:bg-slate-800/40 text-slate-700 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1"></span>
                  Disabled
                </span>
              <% } else if (isClientDev) { %>
                <span class="inline-flex items-center font-bold rounded-full px-2 py-0.5 text-[10px] bg-amber-100 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-300/40">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1"></span>
                  Development
                </span>
              <% } else { %>
                <span class="inline-flex items-center font-bold rounded-full px-2 py-0.5 text-[10px] bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300/40">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                  Production
                </span>
              <% } %>

              <span class="inline-flex items-center font-bold rounded-full px-2 py-0.5 text-[10px] uppercase <%= client.clientType?.toLowerCase() === 'confidential' ? 'bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300 border border-sky-300/30' : 'bg-purple-100 dark:bg-purple-500/20 text-purple-700 dark:text-purple-300 border border-purple-300/30' %>">
                <%= client.clientType %>
              </span>
            </div>

            <div id="domain-input-wrapper" class="<%= isEditing ? 'flex' : 'hidden' %> items-center gap-2 mt-1 max-w-sm">
              <input type="text" id="edit-domain" name="domain" value="<%= client.domain ? client.domain.replace(/^https?:\/\//i, '').replace(/\/+$/, '') : '' %>" required class="w-full text-xs font-mono font-bold text-slate-800 dark:text-slate-200 bg-transparent border-b border-dashed border-slate-300 dark:border-slate-700 focus:border-brand-orange focus:outline-none transition-colors pr-6 py-0.5" placeholder="e.g. yourdomain.com or localhost" />
            </div>
          </div>
        </div>

        <!-- Edit / Save Actions -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <div id="normal-actions" class="<%= isEditing ? 'hidden' : 'flex' %> w-full sm:w-auto">
            <a id="edit-details-btn" href="/client/<%= client.id %>?edit=true" class="btn-outline-sky !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center justify-center gap-1.5 cursor-pointer w-full sm:w-auto">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
              <span>Edit Details</span>
            </a>
          </div>

          <div id="edit-actions" class="<%= isEditing ? 'flex' : 'hidden' %> items-center gap-2 w-full sm:w-auto flex-wrap">
            <button id="save-details-btn" type="submit" class="btn-outline-sky !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center justify-center gap-1.5 cursor-pointer flex-1 sm:flex-initial">
              <svg id="save-btn-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
              <svg id="save-btn-spinner" class="hidden w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
              <span id="save-btn-text">Save</span>
            </button>
            <% if (client.avatar) { %>
              <button type="button" id="trigger-remove-avatar-btn" class="btn-outline-rose !py-1.5 !px-3 !text-xs rounded-lg inline-flex items-center justify-center gap-1.5 cursor-pointer" title="Remove Client Logo">
                <span>Remove Logo</span>
              </button>
            <% } %>
            <a id="cancel-details-btn" href="/client/<%= client.id %>" class="btn-outline-gray !py-1.5 !px-4 !text-xs rounded-lg inline-flex items-center justify-center cursor-pointer flex-1 sm:flex-initial text-center">
              Cancel
            </a>
          </div>
        </div>
      </div>
    </form>

    <!-- Metadata Attributes -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-1">
      <div>
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">Created</p>
        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-0.5"><%= createdAtFormatted %></p>
      </div>
      <div>
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">Last Updated</p>
        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-0.5"><%= updatedAtFormatted %></p>
      </div>
      <div>
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">Status</p>
        <p class="text-xs font-bold <%= client.isActive ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-500' %> mt-0.5">
          <%= client.isActive ? 'Operational' : 'Disabled' %>
        </p>
      </div>
      <div>
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">PKCE Mode</p>
        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-0.5">
          <%= client.enforcePKCE ? 'Enforced' : 'Optional' %>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 2. CREDENTIALS & SECRETS ═══════════════════ -->
  <section id="credentials" class="dashboard-section scroll-mt-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-orange-500/10 dark:bg-brand-orange/15 text-brand-orange flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100">Credentials & Keys</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">OAuth client identity credentials for server-to-server token requests.</p>
      </div>
    </div>

    <div class="space-y-4">
      <!-- Client ID -->
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-[#121212]/90 border border-slate-200/70 dark:border-neutral-800/80 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Client ID</p>
            <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100 truncate mt-1 select-all" id="client-id-val"><%= client.id %></p>
          </div>
          <button type="button" class="copy-btn btn-outline-sky !py-1.5 !px-3 !text-xs shrink-0 cursor-pointer self-start sm:self-center" data-copy-target="client-id-val">
            <span class="copy-btn-label">Copy ID</span>
          </button>
        </div>
      </div>

      <!-- Client Secret -->
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-[#121212]/90 border border-slate-200/70 dark:border-neutral-800/80 shadow-xs space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Client Secret</p>
              <% if (client.client_secret) { %>
                <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-300/30">
                  Revealed Once
                </span>
              <% } %>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Used by confidential clients to authenticate with token endpoints.</p>
          </div>

          <form action="/client/rotate-secret" method="POST" class="shrink-0">
            <input type="hidden" name="client_id" value="<%= client.id %>" />
            <button type="submit" class="btn-outline-sky !py-1.5 !px-3.5 !text-xs cursor-pointer">
              Rotate Secret
            </button>
          </form>
        </div>

        <% if (client.client_secret) { %>
          <div class="rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/30 p-3 text-xs text-amber-900 dark:text-amber-300 font-medium">
            ⚠️ <strong>Save this secret immediately!</strong> It is only displayed once and cannot be retrieved after leaving this page.
          </div>
          <div class="flex items-center gap-2 bg-white dark:bg-[#0a0a0a] rounded-xl px-3.5 py-2.5 border border-slate-200 dark:border-neutral-800 shadow-xs">
            <input id="client-secret" type="text" readonly value="<%= client.client_secret %>" class="flex-1 min-w-0 font-mono text-xs text-slate-800 dark:text-slate-200 bg-transparent focus:outline-none select-all" />
            <button type="button" class="copy-btn btn-orange !py-1 !px-3 !text-xs shrink-0 cursor-pointer" data-copy-target="client-secret">
              <span class="copy-btn-label">Copy Secret</span>
            </button>
          </div>
        <% } else { %>
          <div class="p-3 rounded-xl bg-white/60 dark:bg-[#0a0a0a]/60 border border-slate-200 dark:border-neutral-800/80 text-xs text-slate-500 dark:text-slate-400">
            Client secrets are hashed using SHA-256 and stored securely. Click "Rotate Secret" above to generate a new key when needed.
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 3. REDIRECT URIS ═══════════════════ -->
  <section id="redirects" class="dashboard-section scroll-mt-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100">Allowed Callback URIs</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Whitelisted redirect paths where authentication codes can safely be sent.</p>
      </div>
    </div>

    <!-- URI List -->
    <% if (client.redirectURIs.length === 0) { %>
      <div class="text-center py-8 px-4 rounded-2xl border border-dashed border-slate-200 dark:border-neutral-800/80 bg-slate-50/40 dark:bg-[#121212]/40 mb-5">
        <p class="text-slate-700 dark:text-slate-200 font-bold text-sm">No callback URIs registered</p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Register at least one URI below to accept authorization requests.</p>
      </div>
    <% } else { %>
      <div class="space-y-2 mb-5">
        <% for (let i = 0; i < client.redirectURIs.length; i++) { %>
          <% const uri = client.redirectURIs[i]; %>
          <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 dark:bg-[#121212]/90 border border-slate-200/80 dark:border-neutral-800/80 shadow-xs hover:border-slate-400 dark:hover:border-neutral-700 transition-colors">
            <code id="ruri-<%= i %>" class="font-mono text-xs text-slate-700 dark:text-slate-200 truncate select-all flex-1 min-w-0">
              <%= uri %>
            </code>

            <div class="flex items-center gap-1 shrink-0">
              <!-- Copy Callback URI Button -->
              <button
                type="button"
                class="copy-btn p-1.5 rounded-lg text-slate-400 dark:text-slate-500 hover:text-brand-orange dark:hover:text-brand-orange hover:bg-slate-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
                data-copy-target="ruri-<%= i %>"
                data-copy-text="<%= uri %>"
                title="Copy Callback URI"
                aria-label="Copy Callback URI"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>

              <!-- Remove Callback URI Form -->
              <form method="POST" action="/client/<%= client.id %>/ruri" class="shrink-0">
                <input type="hidden" name="action" value="del" />
                <input type="hidden" name="redirect_uri" value="<%= uri %>" />
                <button
                  type="submit"
                  class="p-1.5 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 hover:text-rose-600 transition-colors cursor-pointer"
                  title="Remove URI"
                  aria-label="Remove URI"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4h6v3m-9 0h12" />
                  </svg>
                </button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Add URI Form -->
    <div class="p-4 rounded-2xl bg-orange-50/20 dark:bg-[#121212]/90 border border-brand-orange/30 shadow-xs">
      <form method="POST" action="/client/<%= client.id %>/ruri" class="space-y-3">
        <input type="hidden" name="action" value="add" />

        <div class="flex flex-col sm:flex-row gap-3">
          <input name="redirect_uri" type="url" required placeholder="<%= isClientDev && (client.domain === 'localhost' || (!isVercelDomain && client.domainStatus !== 'VERIFIED')) ? 'http://localhost:3000/oauth/callback' : 'https://' + client.domain + '/oauth/callback' %>" class="input-field shadow-xs flex-1 min-w-0 text-xs">
          <button type="submit" class="btn-orange !py-2.5 !px-5 !text-xs shrink-0 font-bold w-full sm:w-auto">
            Add URI
          </button>
        </div>
        
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          <% if (isClientDev) { %>
            Development mode allows <code class="font-mono">http://localhost:*</code>, <code class="font-mono">http://127.0.0.1:*</code>, and subdomains of your configured domain.
          <% } else { %>
            Production mode strictly requires secure <code class="font-mono">https://</code> URIs matching your verified custom domain.
          <% } %>
        </p>
      </form>
    </div>
  </section>

  <!-- ═══════════════════ 4. DOMAIN & DNS STATUS ═══════════════════ -->
  <section id="domain" class="dashboard-section scroll-mt-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-sky-500/10 dark:bg-sky-500/15 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100">Domain Ownership & DNS</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">DNS TXT record verification for production callbacks and domain integrity.</p>
      </div>
    </div>

    <!-- Status Message -->
    <% if (client.domain === 'localhost') { %>
      <div class="p-4 rounded-xl bg-sky-50 dark:bg-sky-500/10 border border-sky-200 dark:border-sky-500/30 text-xs text-sky-800 dark:text-sky-200 space-y-1">
        <p class="font-bold">Localhost Development Mode</p>
        <p class="text-[11px] leading-relaxed">No DNS verification is required for localhost. When you are ready for production, click "Edit Details" above to configure your custom domain.</p>
      </div>
    <% } else if (isVercelDomain) { %>
      <div class="p-4 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/30 text-xs text-indigo-800 dark:text-indigo-200 space-y-1">
        <p class="font-bold">Vercel Development Mode</p>
        <p class="text-[11px] leading-relaxed">Vercel domains (*.vercel.app) are active immediately in development mode without DNS TXT records. Switching to Production mode will require a custom domain.</p>
      </div>
    <% } else if (client.domainStatus === 'VERIFIED') { %>
      <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-xs text-emerald-800 dark:text-emerald-200 flex items-center justify-between gap-4">
        <div>
          <p class="font-bold">Domain Verified Successfully</p>
          <p class="text-[11px] leading-relaxed mt-0.5">Ownership of <strong><%= client.domain %></strong> is confirmed. You can safely switch this client to Production.</p>
        </div>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300/40 shrink-0">
          Verified
        </span>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/30 text-xs text-amber-900 dark:text-amber-200">
          <p class="font-bold">DNS TXT Verification Required</p>
          <p class="text-[11px] leading-relaxed mt-0.5">Add the TXT record below in your domain registrar's DNS settings (Cloudflare, Namecheap, Route53, etc.).</p>
        </div>

        <!-- DNS Record Table -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-[#121212]/90 border border-slate-200/70 dark:border-neutral-800/80 shadow-xs space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <p class="text-[10px] font-extrabold uppercase text-slate-400 dark:text-slate-500">Record Type</p>
              <p class="text-xs font-mono font-bold text-slate-800 dark:text-slate-200 mt-1">TXT</p>
            </div>
            <div>
              <p class="text-[10px] font-extrabold uppercase text-slate-400 dark:text-slate-500">Host / Name</p>
              <div class="flex items-center gap-2 mt-1">
                <code class="text-xs font-mono font-bold text-slate-800 dark:text-slate-200 truncate" id="dns-host-val"><%= _dnsInfo.host %></code>
                <button type="button" class="copy-btn text-[10px] font-bold text-brand-orange hover:underline cursor-pointer" data-copy-target="dns-host-val">Copy</button>
              </div>
            </div>
            <div>
              <p class="text-[10px] font-extrabold uppercase text-slate-400 dark:text-slate-500">Value / Token</p>
              <div class="flex items-center gap-2 mt-1">
                <code class="text-xs font-mono font-bold text-slate-800 dark:text-slate-200 truncate" id="dns-val-token"><%= client.verificationToken || client.id %></code>
                <button type="button" class="copy-btn text-[10px] font-bold text-brand-orange hover:underline cursor-pointer" data-copy-target="dns-val-token">Copy</button>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-200/60 dark:border-neutral-800/80 flex items-center justify-between gap-4">
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">FQDN: <%= _dnsInfo.fqdn %></span>
            <form action="/client/<%= client.id %>/domain/verify" method="POST" class="shrink-0">
              <button type="submit" class="btn-orange !py-1.5 !px-4 !text-xs cursor-pointer">
                Verify DNS Ownership
              </button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </section>

  <!-- ═══════════════════ 5. POLICY & ENVIRONMENT ═══════════════════ -->
  <section id="settings" class="dashboard-section scroll-mt-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-purple-500/10 dark:bg-purple-500/15 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100">Environment & Policy</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Configure client security type, PKCE verification, and production status.</p>
      </div>
    </div>

    <div class="space-y-4">
      <!-- Environment Switcher -->
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-[#121212]/90 border border-slate-200/70 dark:border-neutral-800/80 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1 min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <p class="text-xs font-bold text-slate-800 dark:text-slate-200">Policy Mode</p>
            <span class="px-2 py-0.2 rounded text-[10px] font-extrabold uppercase <%= client.environment === 'production' ? 'bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300' : 'bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300' %>">
              <%= client.environment %>
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            <%= client.environment === 'production' ? 'Production enforces secure HTTPS callbacks to your verified custom domain.' : 'Development allows testing with localhost callbacks and development domains.' %>
          </p>
        </div>

        <div class="shrink-0">
          <% if (client.environment === 'development') { %>
            <% if (isVercelDomain) { %>
              <button type="button" disabled class="btn-outline-gray opacity-50 cursor-not-allowed !py-1.5 !px-3.5 !text-xs" title="Requires custom domain">
                Switch to Production
              </button>
            <% } else if (client.domainStatus === 'VERIFIED') { %>
              <a href="/client/<%= client.id %>/environment?environment=production" class="btn-outline-orange !py-1.5 !px-3.5 !text-xs block text-center">
                Switch to Production
              </a>
            <% } else { %>
              <button type="button" disabled class="btn-outline-gray opacity-50 cursor-not-allowed !py-1.5 !px-3.5 !text-xs" title="Verify domain DNS ownership first">
                Switch to Production
              </button>
            <% } %>
          <% } else { %>
            <a href="/client/<%= client.id %>/environment?environment=development" class="btn-outline-orange !py-1.5 !px-3.5 !text-xs block text-center">
              Switch to Development
            </a>
          <% } %>
        </div>
      </div>

      <!-- Client Type Switcher -->
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-[#121212]/90 border border-slate-200/70 dark:border-neutral-800/80 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1 min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <p class="text-xs font-bold text-slate-800 dark:text-slate-200">Client Type</p>
            <span class="px-2 py-0.2 rounded text-[10px] font-extrabold uppercase <%= client.clientType?.toLowerCase() === 'confidential' ? 'bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300' : 'bg-purple-100 dark:bg-purple-500/20 text-purple-700 dark:text-purple-300' %>">
              <%= client.clientType %>
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            <%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'Confidential clients store client secrets securely on a backend server.' : 'Public clients execute in browsers or native devices without client secrets.' %>
          </p>
        </div>

        <form action="/client/<%= client.id %>/type" method="POST" class="shrink-0">
          <input type="hidden" name="client_type" value="<%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'PUBLIC' : 'CONFIDENTIAL' %>" />
          <button type="submit" class="btn-outline-orange !py-1.5 !px-3.5 !text-xs cursor-pointer">
            Switch to <%= client.clientType?.toUpperCase() === 'CONFIDENTIAL' ? 'Public' : 'Confidential' %>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 6. DANGER ZONE ═══════════════════ -->
  <section id="danger" class="dashboard-danger-section scroll-mt-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-rose-500/10 dark:bg-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100">Danger Zone</h2>
        <p class="text-xs text-rose-500/90 dark:text-rose-400">Destructive actions for this application.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Toggle Active Status -->
      <div class="p-4 rounded-2xl bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-neutral-800/80 shadow-xs flex flex-col justify-between gap-3">
        <div>
          <p class="text-xs font-bold text-slate-900 dark:text-slate-100">
            <%= client.isActive ? "Disable Client" : "Activate Client" %>
          </p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
            <%= client.isActive ? "Prevent this client configuration from validating OAuth authorization requests." : "Restore active OAuth authentication validation capacity." %>
          </p>
        </div>

        <% if (client.isActive) { %>
          <a href="/client/<%= client.id %>/deactivate?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-rose !py-2 !text-xs w-full text-center block">
            Disable Client
          </a>
        <% } else { %>
          <a href="/client/<%= client.id %>/activate?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-green !py-2 !text-xs w-full text-center block">
            Activate Client
          </a>
        <% } %>
      </div>

      <!-- Delete Client -->
      <div class="p-4 rounded-2xl bg-white dark:bg-[#0a0a0a] border border-rose-200 dark:border-rose-900/40 shadow-xs flex flex-col justify-between gap-3">
        <div>
          <p class="text-xs font-bold text-slate-900 dark:text-slate-100">Delete Client</p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
            Permanently remove this application, secrets, and registered redirect URIs. This action cannot be reversed.
          </p>
        </div>
        <a href="/client/<%= client.id %>/delete?name=<%= encodeURIComponent(client.name) %>" class="btn-outline-rose !py-2 !text-xs w-full text-center block">
          Delete Client
        </a>
      </div>
    </div>
  </section>

</div>

<script src="/js/copyBtn.js" defer></script>
<script src="/js/client-dashboard.js" defer></script>
