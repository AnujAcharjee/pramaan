<% layout("layouts/main") %>

<% 
  const _flow = flow ?? 'default';
%>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-md">
    <!-- Main Card -->
    <div class="glass-card p-8 sm:p-10 hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <%- include("../../partials/form/header", {
        title: "Sign in",
        subtitle: "Sign in to access your secure account."
      }) %>

      <%- include("../../partials/alert", {success, error}) %>

      <% if (success === "Sign-in verification email has been sent to the registered email address") { %>
      <div class="rounded-2xl border border-green-200 dark:border-emerald-500/20 bg-green-50/50 dark:bg-emerald-500/10 p-4 text-sm text-green-900 dark:text-emerald-400 shadow-xs">
        Check your email for the verification link to complete sign in.
      </div>
      <% } else { %>
      <form method="POST" action="/signin" class="space-y-6">
        <input type="hidden" name="flow" value="<%= _flow %>" />

        <% if (_flow === 'oauth') { %>
        <input type="hidden" name="request_id" value="<%= requestId %>" />
        <% } %>

        <%- include("../../partials/form/input", {
          id: "email",
          name: "email",
          type: "email",
          label: "Email address",
          required: true,
          autocomplete: "email",
          placeholder: "you@example.com"
        }) %>

        <%- include("../../partials/form/input", {
          id: "password",
          name: "password",
          type: "password",
          label: "Password",
          required: true,
          autocomplete: "current-password",
          placeholder: "••••••••",
        }) %>

        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2 cursor-pointer group">
            <input type="checkbox" class="w-4 h-4 accent-brand-orange bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 rounded focus:ring-2 focus:ring-brand-orange/30 transition-all cursor-pointer">
            <span class="text-slate-600 dark:text-slate-400 font-semibold group-hover:text-slate-900 dark:group-hover:text-slate-200">Remember me</span>
          </label>

          <a href="<%= _flow === 'oauth'
            ? `/forgot-password?flow=oauth&request_id=${encodeURIComponent(requestId)}`
            : '/forgot-password' %>" class="font-bold text-brand-orange hover:text-brand-orangeDark transition-all duration-300">
            Forgot password?
          </a>
        </div>

        <button type="submit" class="btn-orange w-full py-4 text-base font-bold shadow-lg shadow-brand-orange/10">
          Sign in
        </button>

      </form>
      <% } %>

      <%- include("../../partials/form/footer", {
        text: "Don't have an account?",
        href: _flow === "oauth"
          ? `/signup?flow=oauth&request_id=${encodeURIComponent(requestId)}`
          : "/signup",
        linkText: "Create one now"
      }) %>

    </div>

    <!-- Trust Indicator -->
    <div class="text-center mt-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 dark:bg-[#121212]/80 backdrop-blur-xs border border-slate-200/40 dark:border-neutral-800/80 shadow-xs dark:shadow-black/10">
        <svg class="w-4 h-4 text-green-600 dark:text-emerald-400 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-semibold text-slate-600 dark:text-slate-500">Secure & Encrypted Session</span>
      </div>
    </div>
  </div>
</div>