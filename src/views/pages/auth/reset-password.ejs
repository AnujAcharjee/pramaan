<% layout("layouts/main") %>

<% const _flow = flow ?? 'default' %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-md">
    <!-- Main Card -->
    <div class="glass-card p-8 sm:p-10 hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <%- include("../../partials/form/header", {
        title: "Reset password",
        subtitle: "Enter and confirm your new password to complete recovery."
      }) %>

      <%- include("../../partials/alert", { success, error }) %>

      <form method="POST" action="/reset-password" class="space-y-6">
        <% if (!resetToken) { %>
        <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-4 text-sm text-amber-900 shadow-xs">
          This reset link is missing or invalid. Please request a new one.
          <div class="mt-2 flex gap-3">
            <a href="<%= _flow === 'oauth'
              ? `/forgot-password?flow=oauth&request_id=${encodeURIComponent(requestId)}`
              : '/forgot-password' %>" class="font-bold text-amber-950 underline underline-offset-2 hover:text-amber-800">
              Forgot password
            </a>
            <span class="text-amber-700">or</span>
            <a href="/account" class="font-bold text-amber-950 underline underline-offset-2 hover:text-amber-800">
              Account
            </a>
          </div>
        </div>
        <% } %>

        <input type="hidden" name="token" value="<%= resetToken || '' %>">
        <input type="hidden" name="flow" value="<%= _flow %>" />
        <% if (_flow === 'oauth') { %>
        <input type="hidden" name="request_id" value="<%= requestId %>" />
        <% } %>

        <%- include("../../partials/form/input", {
          id: "new_password",
          name: "new_password",
          type: "password",
          label: "New password",
          required: true,
          autocomplete: "new-password",
          placeholder: "••••••••",
          minlength: 8,
          maxlength: 100,
          pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&#])[A-Za-z\\d@$!%*?&#]{8,100}$',
          helperText: "Must be at least 8 characters"
        }) %>

        <%- include("../../partials/form/input", {
          id: "confirm_new_password",
          name: "confirm_new_password",
          type: "password",
          label: "Confirm new password",
          required: true,
          autocomplete: "new-password",
          placeholder: "••••••••",
          minlength: 8,
          maxlength: 100,
          pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&#])[A-Za-z\\d@$!%*?&#]{8,100}$',
        }) %>

        <div class="pt-2">
          <%- include("../../partials/form/button", {
            type: "submit",
            text: "Reset password",
            variant: "primary",
            fullWidth: true,
            size: "lg"
          }) %>
        </div>

      </form>
    </div>

    <!-- Trust Indicator -->
    <div class="text-center mt-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-xs border border-slate-200/40 shadow-xs">
        <svg class="w-4 h-4 text-green-600 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-semibold text-slate-600">Secure & Encrypted Session</span>
      </div>
    </div>
  </div>
</div>