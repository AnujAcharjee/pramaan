<% layout("layouts/main") %>

<% 
  const _flow = flow ?? 'default';
%>

<div class="min-h-[calc(100vh-2rem)] flex items-center justify-center py-4 lg:py-6 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-md lg:max-w-2xl">
    <!-- Main Card -->
    <div class="glass-card p-6 sm:p-8 lg:p-7 hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <%- include("../../partials/form/header", {
        title: "Create account",
        subtitle: "Get started with Pramaan. Create your secure identity."
      }) %>

      <%- include("../../partials/alert", {success, error}) %>

      <% if (success === "Sign-in verification email has been sent to the registered email address") { %>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700/30 bg-slate-50/50 dark:bg-[#1a1e2e]/50 p-4 text-sm text-slate-900 dark:text-slate-300 shadow-xs">
        Check your email for the email verification link to complete sign up.
      </div>
      <% } else { %>
      <form method="POST" action="/signup" class="space-y-3.5 lg:space-y-4" id="signupForm">

        <input type="hidden" name="flow" value="<%= _flow %>" />

        <% if (_flow === 'oauth') { %>
        <input type="hidden" name="request_id" value="<%= requestId %>" />
        <% } %>

        <!-- Responsive Grid: 2 columns on lg, 1 column on small -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3.5 lg:gap-x-5 lg:gap-y-3.5">

          <!-- Username / Full name - spans 2 columns on lg (longer!) -->
          <div class="col-span-1 lg:col-span-2">
            <%- include("../../partials/form/input", {
              id: "name",
              name: "name",
              type: "text",
              label: "Username / Full name",
              required: true,
              autocomplete: "name",
              placeholder: "John Doe"
            }) %>
          </div>

          <!-- Email address -->
          <div class="col-span-1">
            <%- include("../../partials/form/input", {
              id: "email",
              name: "email",
              type: "email",
              label: "Email address",
              required: true,
              autocomplete: "email",
              placeholder: "you@example.com"
            }) %>
          </div>

          <!-- Gender -->
          <div class="col-span-1">
            <%- include("../../partials/form/select", {
              id: "gender",
              name: "gender",
              label: "Gender",
              required: true,
              options: [
                { value: "MALE", label: "Male" },
                { value: "FEMALE", label: "Female" },
                { value: "OTHER", label: "Other" }
              ]
            }) %>
          </div>

          <!-- Password -->
          <div class="col-span-1 space-y-1">
            <%- include("../../partials/form/input", {
              id: "password",
              name: "password",
              type: "password",
              label: "Password",
              required: true,
              autocomplete: "new-password",
              placeholder: "••••••••",
              minlength: 8,
              maxlength: 100,
              pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&#])[A-Za-z\\d@$!%*?&#]{8,100}$',
            }) %>

            <!-- Password Strength Indicator -->
            <div id="passwordStrengthContainer" class="hidden space-y-1 pt-1 transition-all duration-300">
              <div class="flex gap-1">
                <div class="h-1 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                  <div id="strengthBar1" class="h-full w-0 rounded-full transition-all duration-300"></div>
                </div>
                <div class="h-1 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                  <div id="strengthBar2" class="h-full w-0 rounded-full transition-all duration-300"></div>
                </div>
                <div class="h-1 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                  <div id="strengthBar3" class="h-full w-0 rounded-full transition-all duration-300"></div>
                </div>
                <div class="h-1 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                  <div id="strengthBar4" class="h-full w-0 rounded-full transition-all duration-300"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <p id="strengthText" class="text-[11px] font-medium ml-0.5 transition-colors duration-300"></p>
                <div id="strengthChecks" class="flex gap-2 text-[10px] text-slate-400 dark:text-slate-600">
                  <span id="checkLength" title="Min 8 characters">8+</span>
                  <span id="checkUpper" title="Uppercase letter">A-Z</span>
                  <span id="checkLower" title="Lowercase letter">a-z</span>
                  <span id="checkDigit" title="Number">0-9</span>
                  <span id="checkSpecial" title="Special character">@#$</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Confirm Password - side by side with Password! -->
          <div class="col-span-1 space-y-1">
            <%- include("../../partials/form/input", {
              id: "confirmPassword",
              name: "confirmPassword",
              type: "password",
              label: "Confirm password",
              required: true,
              autocomplete: "new-password",
              placeholder: "••••••••",
              minlength: 8,
              maxlength: 100,
              pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&#])[A-Za-z\\d@$!%*?&#]{8,100}$',
            }) %>

            <!-- Password Match Indicator -->
            <div id="passwordMatchContainer" class="hidden pt-1 transition-all duration-300">
              <p id="passwordMatchText" class="text-[11px] font-medium ml-0.5 flex items-center gap-1"></p>
            </div>
          </div>

        </div>

        <button type="submit" class="btn-orange w-full py-3 text-base font-bold shadow-lg shadow-brand-orange/10 mt-1 cursor-pointer">
          Sign up
        </button>

      </form>

      <%- include("../../partials/form/footer", {
        text: "Already have an account?",
        href: _flow === "oauth"
          ? `/signin?flow=oauth&request_id=${encodeURIComponent(requestId)}`
          : "/signin",
        linkText: "Sign in"
      }) %>

      <% } %>
    </div>

    <!-- Trust Indicator -->
    <div class="text-center mt-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/60 dark:bg-[#161a2a]/60 backdrop-blur-xs border border-slate-200/40 dark:border-slate-700/25 shadow-xs dark:shadow-black/10">
        <svg class="w-3.5 h-3.5 text-green-600 dark:text-emerald-400 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-500">Secure & Encrypted Session</span>
      </div>
    </div>
  </div>
</div>

<script src="/js/signup.js?v=1" defer></script>