<% layout('layouts/main') %>

<%
  const _scopes = Array.isArray(scopes) ? scopes : [];
  const _appName = clientName || 'Application';
  const _initials = _appName.trim().slice(0, 2).toUpperCase();
  const _user = typeof user !== 'undefined' && user ? user : null;

  const scopeDetails = {
    openid: {
      title: 'Confirm your identity',
      desc: 'Verify who you are using your unique Pramaan ID',
      icon: '<svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>'
    },
    email: {
      title: 'View your email address',
      desc: _user ? `Access ${_user.email}` : 'Access the primary email address on your account',
      icon: '<svg class="w-5 h-5 text-sky-500 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>'
    },
    profile: {
      title: 'View basic profile info',
      desc: 'Access your display name, username, and public profile data',
      icon: '<svg class="w-5 h-5 text-emerald-500 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>'
    },
    avatar: {
      title: 'View your profile picture',
      desc: 'Display your avatar picture in their application',
      icon: '<svg class="w-5 h-5 text-purple-500 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>'
    }
  };
%>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-10 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-lg">
    
    <!-- Main Card -->
    <div class="glass-card overflow-hidden shadow-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/95 dark:bg-[#0f121d]/95 backdrop-blur-2xl">

      <!-- Header: Connect Logos -->
      <div class="p-8 pb-4 text-center">
        <!-- Two Connected App Avatars -->
        <div class="flex items-center justify-center gap-3 mb-5">
          <!-- Client App Avatar -->
          <div class="w-14 h-14 rounded-2xl bg-linear-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-700 flex items-center justify-center border border-slate-300/60 dark:border-slate-600/50 shadow-md">
            <span class="text-base font-black tracking-wider text-slate-800 dark:text-slate-100"><%= _initials %></span>
          </div>

          <!-- Connected Arrow -->
          <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800/80 flex items-center justify-center text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-slate-700/60 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>

          <!-- Pramaan IdP Avatar -->
          <div class="w-14 h-14 rounded-2xl bg-linear-to-br from-brand-orange to-brand-orangeDark flex items-center justify-center border border-orange-400/30 shadow-md shadow-brand-orange/20">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Sign in to <span class="text-transparent bg-clip-text bg-linear-to-r from-brand-orange to-orange-500"><%= _appName %></span>
        </h1>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 font-medium">
          wants to access your <span class="font-bold text-slate-850 dark:text-slate-200">Pramaan Account</span>
        </p>

        <!-- Requesting Domain Badge -->
        <div class="inline-flex items-center gap-1.5 mt-3 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 text-[11px] font-mono font-semibold text-slate-600 dark:text-slate-300">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span><%= clientDomain %></span>
        </div>
      </div>

      <!-- User Identity Pill (Google Style) -->
      <% if (_user) { %>
      <div class="px-8 py-2">
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-[#141724] border border-slate-200/80 dark:border-slate-700/60">
          <% if (_user.avatar) { %>
          <img src="<%= _user.avatar %>" alt="<%= _user.name %>" class="w-10 h-10 rounded-full object-cover ring-2 ring-brand-orange/30 shrink-0" />
          <% } else { %>
          <div class="w-10 h-10 rounded-full bg-brand-orange/15 text-brand-orange font-bold text-sm flex items-center justify-center shrink-0 border border-brand-orange/30">
            <%= _user.name.slice(0, 1).toUpperCase() %>
          </div>
          <% } %>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-bold text-slate-900 dark:text-white truncate"><%= _user.name %></p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium truncate"><%= _user.email %></p>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-800/40">Active</span>
        </div>
      </div>
      <% } %>

      <!-- Content: Scopes & Permissions -->
      <div class="p-8 pt-4 space-y-4">

        <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          This will allow <%= _appName %> to:
        </p>

        <!-- Permissions List -->
        <div class="space-y-2.5">
          <% if (_scopes.length === 0) { %>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-[#141724] border border-slate-200/80 dark:border-slate-700/60 text-center">
            <p class="text-xs text-slate-600 dark:text-slate-400 font-medium">Basic authentication only</p>
          </div>
          <% } else { %>
            <% _scopes.forEach(function (s) { %>
              <% const detail = scopeDetails[s] || {
                title: s.replace(':', ' ').replace('_', ' '),
                desc: 'Access requested permissions on your account',
                icon: '<svg class="w-5 h-5 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>'
              }; %>
              <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50/80 dark:bg-[#141724] border border-slate-200/80 dark:border-slate-700/50 hover:border-slate-300 dark:hover:border-slate-600/70 transition-colors">
                <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-800/80 flex items-center justify-center shrink-0 border border-slate-200/60 dark:border-slate-700/50 shadow-xs">
                  <%- detail.icon %>
                </div>
                <div class="flex-1 min-w-0 mt-0.5">
                  <p class="text-xs font-bold text-slate-900 dark:text-slate-100"><%= detail.title %></p>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 font-medium leading-relaxed"><%= detail.desc %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Trust & Revocation Notice (Google Standard) -->
        <div class="p-3.5 rounded-2xl bg-amber-50/70 dark:bg-amber-950/20 border border-amber-200/70 dark:border-amber-800/30">
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-[11px] text-amber-900 dark:text-amber-300 font-medium leading-relaxed">
              You can review or revoke this app's access anytime in your <a href="/account" class="font-bold underline hover:text-amber-950 dark:hover:text-amber-200">Pramaan Account Dashboard</a>.
            </p>
          </div>
        </div>

      </div>

      <!-- Actions (Google Style: Cancel left, Allow right) -->
      <form method="POST" action="/oauth/consent" class="p-6 bg-slate-50/90 dark:bg-[#121524] border-t border-slate-200/70 dark:border-slate-800">
        <input type="hidden" name="request_id" value="<%= requestId %>" />

        <div class="flex items-center justify-end gap-3">
          <button
            type="submit"
            name="decision"
            value="deny"
            class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-semibold transition-all duration-200 cursor-pointer"
          >
            Cancel
          </button>

          <button
            type="submit"
            name="decision"
            value="approve"
            class="px-6 py-2.5 rounded-xl bg-linear-to-r from-brand-orange via-brand-orange to-brand-orangeDark text-white text-sm font-bold shadow-md shadow-brand-orange/20 hover:shadow-lg hover:shadow-brand-orange/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 cursor-pointer"
          >
            Allow Access
          </button>
        </div>
      </form>

    </div>

    <!-- Security Indicator -->
    <div class="text-center mt-5">
      <p class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Secured with Pramaan OpenID Connect</span>
      </p>
    </div>

  </div>
</div>
