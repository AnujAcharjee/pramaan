<!DOCTYPE html>
<html lang="en">

<head>
  <%- partial("../partials/head", locals) %>
  <script>
    try {
      if (window.innerWidth >= 1024 && localStorage.getItem('pramaan_console_sidebar_collapsed') === 'true') {
        document.documentElement.classList.add('console-sidebar-collapsed');
      }
    } catch (e) {}
  </script>
</head>

<body class="h-screen max-h-screen overflow-hidden bg-theme text-slate-900 dark:text-slate-200 antialiased flex flex-col transition-colors duration-300">

  <!-- Animated Background Orbs -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-20 -right-20 w-[30rem] h-[30rem] bg-linear-to-br from-orange-400/25 to-amber-500/15 dark:from-brand-orange/10 dark:to-transparent rounded-full blur-3xl animate-float"></div>
    <div class="absolute -bottom-28 -left-28 w-[30rem] h-[30rem] bg-linear-to-tr from-sky-400/20 to-indigo-500/15 dark:from-transparent dark:to-transparent rounded-full blur-3xl animate-float-delayed"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-xl h-128 bg-linear-to-br from-orange-300/10 to-transparent dark:from-brand-orange/6 dark:to-transparent rounded-full blur-3xl animate-pulse-slow"></div>
  </div>

  <style>
    body {
      font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    #consoleLayoutContainer {
      height: calc(100vh - 3.5rem);
      max-height: calc(100vh - 3.5rem);
      display: flex;
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    #consoleSidebar {
      height: 100%;
      max-height: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    #consoleMain {
      flex: 1 1 0%;
      min-width: 0;
      height: 100%;
      max-height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      position: relative;
      z-index: 10;
    }

    /* Sleek AWS Console Scrollbars */
    #consoleMain,
    #consoleSidebarNav {
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 150, 68, 0.4) transparent;
    }

    #consoleMain::-webkit-scrollbar,
    #consoleSidebarNav::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    #consoleMain::-webkit-scrollbar-track,
    #consoleSidebarNav::-webkit-scrollbar-track {
      background: transparent;
    }

    #consoleMain::-webkit-scrollbar-thumb,
    #consoleSidebarNav::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.35);
      border-radius: 9999px;
    }

    :is(.dark #consoleMain)::-webkit-scrollbar-thumb,
    :is(.dark #consoleSidebarNav)::-webkit-scrollbar-thumb {
      background: rgba(255, 150, 68, 0.3);
      border-radius: 9999px;
    }

    #consoleMain::-webkit-scrollbar-thumb:hover,
    #consoleSidebarNav::-webkit-scrollbar-thumb:hover {
      background: #fa812f;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(6deg); }
    }

    @keyframes float-delayed {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-25px) rotate(-6deg); }
    }

    @keyframes pulse-slow {
      0%, 100% { opacity: 0.25; }
      50% { opacity: 0.45; }
    }

    .animate-float { animation: float 10s ease-in-out infinite; }
    .animate-float-delayed { animation: float-delayed 12s ease-in-out infinite; animation-delay: 2s; }
    .animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }
  </style>

  <!-- Top Console Header (Pinned at top, non-scrolling) -->
  <%- partial("../partials/app/console-header", locals) %>

  <!-- 2-Part Layout: LHS Sidebar Nav + RHS Main Functionality (Independent Scrolling Sections) -->
  <div id="consoleLayoutContainer" class="w-full flex overflow-hidden relative">

    <!-- LHS Sidebar Navigation (Separate section with dedicated scroll) -->
    <%- partial("../partials/app/console-sidebar", locals) %>

    <!-- RHS Main Content Area (Separate section with dedicated scroll) -->
    <main id="consoleMain" class="flex-1 min-w-0 overflow-y-auto relative z-10 transition-all duration-300">
      <%- body %>
    </main>

  </div>

  <script src="/js/alert.js?v=3" defer></script>
  <script src="/js/theme.js?v=3" defer></script>
  <script src="/js/console-nav.js?v=3" defer></script>
  <script src="/js/password-toggle.js?v=4" defer></script>
</body>

</html>
