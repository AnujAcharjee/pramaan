<!DOCTYPE html>
<html lang="en">

<head>
  <%- partial("../partials/head", { title }) %>

  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title ?? "Pramaan - Secure Identity Provider" %>">
  <meta property="og:description" content="Authenticate users securely with Pramaan identity platform.">
  <meta property="og:url" content="https://pramaan.anujacharjee.com/">
  <meta property="og:image" content="https://pramaan.anujacharjee.com/images/landing-preview.png">
  <meta property="og:site_name" content="Pramaan">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title ?? "Pramaan - Secure Identity Provider" %>">
  <meta name="twitter:description" content="Authenticate users securely with Pramaan identity platform.">
  <meta name="twitter:image" content="https://pramaan.anujacharjee.com/images/landing-preview.png">
  <meta name="twitter:creator" content="@anuj_304">

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Pramaan",
      "url": "https://pramaan.anujacharjee.com",
      "description": "Modern OAuth 2.0 and OpenID Connect identity provider.",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Web",
      "creator": {
        "@type": "Person",
        "name": "Anuj Acharjee"
      }
    }
  </script>
</head>

<script src="/js/navbar.js?v=3" defer></script>

<body class="min-h-screen bg-theme text-slate-900 dark:text-slate-200 antialiased overflow-x-hidden transition-colors duration-300">

  <!-- Animated Background -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">

    <!-- Floating Gradient Orbs -->
    <div class="absolute -top-20 -right-20 w-[30rem] h-[30rem] bg-linear-to-br from-orange-400/30 to-amber-500/20 dark:from-brand-orange/20 dark:to-amber-500/10 rounded-full blur-3xl animate-float"></div>

    <div class="absolute -bottom-28 -left-28 w-[30rem] h-[30rem] bg-linear-to-tr from-sky-400/25 to-indigo-500/20 dark:from-indigo-600/20 dark:to-sky-500/15 rounded-full blur-3xl animate-float-delayed"></div>

    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-xl h-128 bg-linear-to-br from-orange-300/15 to-transparent dark:from-brand-orange/12 dark:to-indigo-500/8 rounded-full blur-3xl animate-pulse-slow"></div>

    <!-- Subtle Grid Pattern -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.035] dark:opacity-[0.07]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

  </div>

  <!-- Animation Styles -->
  <style>
    body {
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px) rotate(0deg);
      }

      50% {
        transform: translateY(-20px) rotate(6deg);
      }
    }

    @keyframes float-delayed {

      0%,
      100% {
        transform: translateY(0px) rotate(0deg);
      }

      50% {
        transform: translateY(-25px) rotate(-6deg);
      }
    }

    @keyframes pulse-slow {

      0%,
      100% {
        opacity: 0.25;
      }

      50% {
        opacity: 0.45;
      }
    }

    .animate-float {
      animation: float 10s ease-in-out infinite;
    }

    .animate-float-delayed {
      animation: float-delayed 12s ease-in-out infinite;
      animation-delay: 2s;
    }

    .animate-pulse-slow {
      animation: pulse-slow 8s ease-in-out infinite;
    }
  </style>

  <!-- Page Content -->
  <main class="relative z-10">
    <%- body %>
  </main>

  <script src="/js/theme.js?v=3"></script>
</body>

</html>