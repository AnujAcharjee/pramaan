<%
  const _activeNav = typeof activeNav !== 'undefined' ? activeNav : '';
  const _client = typeof client !== 'undefined' && client ? client : null;
  const _user = typeof user !== 'undefined' && user ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : null);
  const _clients = typeof clients !== 'undefined' && Array.isArray(clients) ? clients : (typeof locals !== 'undefined' && Array.isArray(locals.clients) ? locals.clients : null);
  const _isClientPage = _activeNav === 'client' && _client;
  const _isDeveloperPage = ['developer', 'create-client'].includes(_activeNav);
  const _isAccountPage = _activeNav === 'account' || (!_isClientPage && !_isDeveloperPage);
%>

<style>
  /* Base sidebar surface matching .bg-theme */
  #consoleSidebar {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    border-right: 1px solid rgba(226, 232, 240, 0.8);
  }
  :is(.dark #consoleSidebar) {
    background-color: rgba(10, 10, 10, 0.85) !important;
    border-right: 1px solid rgba(38, 38, 38, 0.8) !important;
  }

  /* Mobile: Full-screen takeover drawer */
  @media (max-width: 1023px) {
    #consoleSidebar {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      max-width: 100vw !important;
      z-index: 70 !important;
      display: none;
      flex-direction: column;
      background-color: rgba(255, 255, 255, 0.98) !important;
    }
    :is(.dark #consoleSidebar) {
      background-color: rgba(5, 5, 5, 0.98) !important;
    }
    #consoleSidebar.sidebar-open {
      display: flex !important;
      animation: consoleMenuFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes consoleMenuFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop: LHS dedicated nav bar (w-64), collapsible to 0 width */
  @media (min-width: 1024px) {
    #consoleSidebar {
      width: 16rem;
      height: 100%;
      max-height: 100%;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
    }
    #consoleSidebar.sidebar-collapsed,
    html.console-sidebar-collapsed #consoleSidebar {
      display: none !important;
    }
  }

  /* Modern card surfaces */
  .sidebar-card {
    background-color: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    transition: all 0.2s ease;
  }
  :is(.dark .sidebar-card) {
    background-color: #0d0d0d !important;
    border: 1px solid #262626 !important;
  }

  /* Navigation links */
  .sidebar-link {
    color: #475569;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }
  .sidebar-link:hover {
    color: #0f172a;
    background-color: rgba(241, 245, 249, 0.9);
  }
  :is(.dark .sidebar-link) {
    color: #cbd5e1;
  }
  :is(.dark .sidebar-link:hover) {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .nav-item-active {
    background-color: rgba(255, 150, 68, 0.12) !important;
    color: #fa812f !important;
    border: 1px solid rgba(255, 150, 68, 0.35) !important;
    font-weight: 700 !important;
  }

  /* Bottom Utility */
  .sidebar-bottom-utility {
    background-color: rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(226, 232, 240, 0.8);
  }
  :is(.dark .sidebar-bottom-utility) {
    background-color: rgba(10, 10, 10, 0.9) !important;
    border-top: 1px solid rgba(38, 38, 38, 0.8) !important;
  }
</style>

<!-- Mobile Backdrop -->
<div id="consoleBackdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-40 hidden opacity-0 transition-opacity duration-200 lg:hidden" aria-hidden="true"></div>

<!-- LHS Sidebar -->
<aside id="consoleSidebar" class="h-full overflow-hidden flex flex-col shrink-0 select-none shadow-xl lg:shadow-none transition-colors duration-200">
  
  <!-- Scrollable Nav Content -->
  <div id="consoleSidebarNav" class="flex-1 min-h-0 overflow-y-auto scrollbar-thin p-3.5 space-y-4">

    <!-- Mobile Drawer Header -->
    <div class="flex items-center justify-between pb-3.5 mb-2 border-b border-slate-200 dark:border-neutral-800 lg:hidden">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-linear-to-br from-brand-orange to-brand-orangeDark flex items-center justify-center text-white shadow-xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <span class="font-extrabold text-sm tracking-tight text-slate-900 dark:text-slate-100 block">Pramaan Console</span>
          <span class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Navigation Menu</span>
        </div>
      </div>

      <button id="consoleCloseBtn" type="button" class="w-9 h-9 rounded-xl border border-slate-200 dark:border-neutral-800 bg-slate-100 dark:bg-neutral-900 text-slate-700 dark:text-slate-200 hover:text-brand-orange dark:hover:text-brand-orange hover:border-brand-orange/40 dark:hover:bg-neutral-800 flex items-center justify-center transition-colors cursor-pointer" aria-label="Close menu" title="Close menu">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- ═══════════════════ CONTEXT 1: CLIENT MANAGEMENT ═══════════════════ -->
    <% if (_isClientPage) { %>
      <div class="space-y-3">
        <!-- Configuration Section (In-Page Feature Anchors) -->
        <div class="space-y-0.5">
          <div class="px-2 pt-1 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
            Configuration
          </div>

          <a href="#overview" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Overview</span>
          </a>

          <a href="#credentials" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <span>Credentials & Secret</span>
          </a>

          <a href="#redirects" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span>Allowed Callback URIs</span>
          </a>

          <a href="#domain" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span>Domain & DNS Status</span>
          </a>

          <a href="#settings" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Environment & Policy</span>
          </a>

          <a href="#danger" class="console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-500 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 border border-transparent transition-all">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4h6v3m-9 0h12" />
            </svg>
            <span>Danger Zone</span>
          </a>
        </div>
      </div>

      <!-- Navigation Section -->
      <div class="pt-3 border-t border-slate-200 dark:border-neutral-800 space-y-1">
        <div class="px-2 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          Navigation
        </div>

        <a href="/developer" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Developer Console</span>
        </a>

        <a href="/account" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Account</span>
        </a>
      </div>

    <!-- ═══════════════════ CONTEXT 2: DEVELOPER CONSOLE ═══════════════════ -->
    <% } else if (_isDeveloperPage) { %>
      <div class="space-y-3">
        <div class="px-2 pb-0.5 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          Developer Hub
        </div>

        <!-- Create Application Button -->
        <a href="/client/create" class="flex items-center justify-center gap-2 w-full px-3 py-2.5 rounded-xl font-bold text-xs bg-linear-to-r from-brand-orange via-brand-orange/95 to-brand-orangeDark text-white shadow-md shadow-brand-orange/20 hover:shadow-lg hover:shadow-brand-orange/30 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span>Register New Client</span>
        </a>

        <!-- Registered App Count -->
        <div class="sidebar-card p-3 rounded-2xl flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300">
            <svg class="w-4 h-4 text-brand-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>My Applications</span>
          </div>
          <span class="px-2 py-0.5 rounded-md text-xs font-black bg-brand-orange/15 text-brand-orange border border-brand-orange/30">
            <%= _clients ? _clients.length : '0' %>
          </span>
        </div>

        <!-- All Applications Link -->
        <a href="/developer" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold <%= _activeNav === 'developer' ? 'nav-item-active' : '' %>">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span>All Applications</span>
        </a>
      </div>

      <!-- Navigation Section -->
      <div class="pt-3 border-t border-slate-200 dark:border-neutral-800 space-y-1">
        <div class="px-2 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          Navigation
        </div>

        <a href="/account" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>User Account</span>
        </a>
      </div>

    <!-- ═══════════════════ CONTEXT 3: ACCOUNT ═══════════════════ -->
    <% } else { %>
      <div class="space-y-1">
        <div class="px-2 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          Account Portal
        </div>

        <a href="#profile" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Profile & Identity</span>
        </a>

        <a href="#security" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Security & 2FA</span>
        </a>

        <a href="#consents" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Authorized Apps</span>
        </a>

        <a href="#sessions" class="sidebar-link console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
          </svg>
          <span>Active Sessions</span>
        </a>

        <a href="#danger" class="console-nav-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-500 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 border border-transparent transition-all">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4h6v3m-9 0h12" />
          </svg>
          <span>Danger Zone</span>
        </a>
      </div>

      <!-- Navigation Section -->
      <div class="pt-3 border-t border-slate-200 dark:border-neutral-800 space-y-1">
        <div class="px-2 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
          Navigation
        </div>

        <a href="/developer" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold">
          <svg class="w-4 h-4 shrink-0 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Developer Console</span>
        </a>
      </div>
    <% } %>

  </div>

  <!-- Bottom Utility: Sign Out Form -->
  <div class="sidebar-bottom-utility p-3 shrink-0">
    <form action="/signout" method="POST" class="w-full">
      <button
        type="submit"
        class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors cursor-pointer group"
      >
        <svg class="w-4 h-4 shrink-0 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Sign Out</span>
      </button>
    </form>
  </div>

</aside>
