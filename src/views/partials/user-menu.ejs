<%
  const avatar = user.avatar 
   ? user.avatar 
   : '/images/default-avatar.png';
%>

<div class="relative group">
  <button class="flex items-center gap-3 hover:opacity-90 transition-all duration-300 py-1.5 px-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-100 cursor-pointer">
    <img src="<%= avatar %>" alt="<%= user.name %>" class="w-8 h-8 rounded-full object-cover ring-2 ring-brand-orange/20" />
    <span class="text-sm font-semibold text-slate-700 hidden sm:block"><%= user.name %></span>
    <svg class="w-4 h-4 text-slate-400 hidden sm:block transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  
  <!-- Dropdown Menu -->
  <div class="absolute right-0 mt-2 w-48 bg-white/95 backdrop-blur-xl rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 py-2 origin-top-right transition-all duration-300 scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto z-50">
    <div class="px-4 py-2 border-b border-slate-100">
      <p class="text-xs text-slate-400">Signed in as</p>
      <p class="text-sm font-bold text-slate-700 truncate"><%= user.name %></p>
    </div>
    
    <div class="p-1 space-y-1">
      <a href="/account" class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-slate-600 rounded-xl hover:bg-slate-50 hover:text-slate-900 transition-colors">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        Account Profile
      </a>
      
      <form method="POST" action="/signout">
        <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm font-medium text-red-600 rounded-xl hover:bg-red-50 transition-colors cursor-pointer">
          <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
          </svg>
          Sign out
        </button>
      </form>
    </div>
  </div>
</div>
