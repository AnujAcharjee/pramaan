<!-- Light mode logo (hidden in dark mode) -->
<svg viewBox="0 0 330 95" class="h-9 sm:h-12 lg:h-16 w-auto block dark:hidden" fill="none" xmlns="http://www.w3.org/2000/svg">

  <!-- Brand Name -->
  <text x="0" y="45" font-family="'Instrument Sans', 'Satoshi', 'Segoe UI', system-ui, sans-serif" font-size="36" font-weight="800" fill="url(#textGradientLight)" letter-spacing="-1">
    PRAMAAN
  </text>

  <!-- Tagline -->
  <text x="2" y="70" font-family="'Instrument Sans', 'Segoe UI', system-ui, sans-serif" font-size="12" font-weight="500" fill="#475569" letter-spacing="2">
    TRUSTED IDENTITY PROVIDER
  </text>

  <!-- Accent Line -->
  <rect x="0" y="55" width="255" height="2" rx="1" fill="url(#accentGradientLight)" opacity="0.4" />

  <!-- Gradients -->
  <defs>

    <linearGradient id="textGradientLight" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#334155" />
    </linearGradient>

    <linearGradient id="accentGradientLight" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#F97316" />
      <stop offset="100%" stop-color="#EA580C" />
    </linearGradient>

  </defs>

</svg>

<!-- Dark mode logo (hidden in light mode) -->
<svg viewBox="0 0 330 95" class="h-9 sm:h-12 lg:h-16 w-auto hidden dark:block" fill="none" xmlns="http://www.w3.org/2000/svg">

  <!-- Brand Name -->
  <text x="0" y="45" font-family="'Instrument Sans', 'Satoshi', 'Segoe UI', system-ui, sans-serif" font-size="36" font-weight="800" fill="url(#textGradientDark)" letter-spacing="-1">
    PRAMAAN
  </text>

  <!-- Tagline -->
  <text x="2" y="70" font-family="'Instrument Sans', 'Segoe UI', system-ui, sans-serif" font-size="12" font-weight="500" fill="#94A3B8" letter-spacing="2">
    TRUSTED IDENTITY PROVIDER
  </text>

  <!-- Accent Line -->
  <rect x="0" y="55" width="255" height="2" rx="1" fill="url(#accentGradientDark)" opacity="0.5" />

  <!-- Gradients -->
  <defs>

    <linearGradient id="textGradientDark" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#F1F5F9" />
      <stop offset="100%" stop-color="#CBD5E1" />
    </linearGradient>

    <linearGradient id="accentGradientDark" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FB923C" />
      <stop offset="100%" stop-color="#F97316" />
    </linearGradient>

  </defs>

</svg>