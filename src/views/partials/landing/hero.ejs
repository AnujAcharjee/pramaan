<%
  const _user = typeof user !== 'undefined' && user ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : null);
%>
<section id="hero" class="relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 lg:px-12 py-12 sm:py-20 lg:py-24 relative z-10">

    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">

      <!-- Identity Provider Tag -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-orange/10 text-brand-orange border border-brand-orange/20 tracking-wider uppercase mb-4 sm:mb-6">
        <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>Identity Provider</span>
      </div>

      <!-- Hero Heading -->
      <div class="relative inline-block mb-5 sm:mb-7">
        <!-- Ambient Glow -->
        <div
          class="absolute -top-10 left-1/2 -translate-x-1/2 w-72 sm:w-96 h-36
                 bg-linear-to-r from-brand-orange/30 via-amber-400/20 to-indigo-500/20
                 dark:from-brand-orange/25 dark:via-amber-400/15 dark:to-indigo-500/15
                 blur-3xl rounded-full pointer-events-none"
        ></div>

        <h1
          class="relative font-brand-hero text-3xl min-[380px]:text-4xl
                 sm:text-5xl lg:text-7xl font-extrabold tracking-tight
                 text-slate-900 dark:text-white leading-tight sm:leading-[1.12]"
        >
          Ship authentication in
          <br class="sm:hidden" />

          <span
            class="text-transparent bg-clip-text
                   bg-linear-to-r from-brand-orange via-amber-500 to-orange-500
                   dark:from-brand-orange dark:via-amber-300 dark:to-orange-400
                   drop-shadow-[0_0_35px_rgba(255,150,68,0.22)]"
          >
            just a few clicks.
          </span>
        </h1>
      </div>

      <!-- Supporting Copy -->
      <div class="mt-5 sm:mt-7 flex flex-col items-center">
        <p
          class="text-base sm:text-xl text-slate-600 dark:text-slate-300
                 leading-relaxed max-w-2xl text-center px-4"
        >
          Set up your application in Pramaan, grab your credentials,
          and use the official SDK to add secure authentication to your app.
        </p>

        <!-- CTA -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-center gap-3.5">
          <a
            href="<%= _user ? '/account' : '/signup' %>"
            class="btn-orange rounded-2xl border border-brand-orange/40 dark:border-brand-orange/50
                   text-base sm:text-lg shadow-xl shadow-brand-orange/20
                   hover:shadow-2xl hover:shadow-brand-orange/30
                   hover:-translate-y-0.5 active:translate-y-0
                   px-8 py-3.5"
          >
            Get Started
          </a>

          <a
            href="#demo"
            class="text-base sm:text-lg font-semibold
                   rounded-2xl border border-slate-300 dark:border-slate-700
                   backdrop-blur-md
                   text-slate-800 dark:text-slate-100
                   hover:text-slate-900 dark:hover:text-white
                   hover:bg-slate-100 dark:hover:bg-slate-700
                   hover:border-slate-400 dark:hover:border-slate-600
                   transition-all duration-200 px-6 py-3.5 shadow-sm"
          >
            See how it works
          </a>
        </div>
      </div>

    </div>
  </div>
</section>