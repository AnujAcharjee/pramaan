<%
  const _user = typeof user !== 'undefined' && user ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : null);
%>
<section id="hero" class="relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 lg:py-18 relative z-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">

      <!-- Left Column: Copy & Get Started CTA -->
      <div class="lg:col-span-6 flex flex-col items-center lg:items-start text-center lg:text-left">

        <!-- Identity Provider Tag -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-brand-orange/10 text-brand-orange border border-brand-orange/20 dark:border-brand-orange/30 tracking-wider uppercase mb-3.5 sm:mb-5">
          <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Identity Provider</span>
        </div>

        <!-- Hero Heading (Strictly 2 lines) -->
        <div class="relative inline-block mb-3.5 sm:mb-5">
          <!-- Ambient Glow -->
          <div
            class="absolute -top-8 left-1/2 -translate-x-1/2 lg:left-0 lg:translate-x-0 w-72 sm:w-96 h-36
                   bg-linear-to-r from-brand-orange/30 via-amber-400/20 to-indigo-500/20
                   dark:from-brand-orange/25 dark:via-amber-400/15 dark:to-indigo-500/15
                   blur-3xl rounded-full pointer-events-none"
          ></div>

          <h1
            class="relative font-brand-hero text-[1.95rem] min-[380px]:text-[2.2rem] sm:text-4xl lg:text-[2.15rem] xl:text-[2.75rem] 2xl:text-[3.25rem] font-bold tracking-tight text-slate-900 dark:text-white leading-[1.12]"
          >
            <span class="block min-[380px]:whitespace-nowrap">Ship authentication in</span>
            <span
              class="block min-[380px]:whitespace-nowrap text-transparent bg-clip-text
                     bg-linear-to-r from-brand-orange via-amber-500 to-orange-500
                     dark:from-brand-orange dark:via-amber-300 dark:to-orange-400
                     drop-shadow-[0_0_35px_rgba(255,150,68,0.22)]"
            >
              just a few clicks.
            </span>
          </h1>
        </div>

        <!-- Supporting Copy -->
        <p
          class="text-sm sm:text-base lg:text-[1.05rem] text-slate-600 dark:text-slate-300
                 leading-relaxed max-w-lg text-center lg:text-left"
        >
          Set up your application in Pramaan, grab your credentials,
          and use the official SDK to add secure authentication to your app.
        </p>

        <!-- CTA: Get Started Button -->
        <div class="mt-6 sm:mt-8 flex items-center">
          <a
            href="<%= _user ? '/account' : '/signup' %>"
            class="btn-orange group inline-flex items-center gap-2.5 px-7 py-3.5
                   text-sm sm:text-base font-semibold
                   shadow-lg shadow-brand-orange/20 hover:shadow-xl hover:shadow-brand-orange/30
                   hover:-translate-y-0.5 active:translate-y-0
                   transition-all duration-200"
          >
            <span>Get Started</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Video Frame Showcase (No header, with caption & i tag) -->
      <div id="demo" class="lg:col-span-6 w-full">
        <div class="relative group w-full">
          <!-- Ambient Glow behind video -->
          <div
            class="absolute -top-6 -right-6 w-72 h-44
                   bg-linear-to-r from-brand-orange/25 via-amber-400/15 to-indigo-500/10
                   dark:from-brand-orange/20 dark:via-amber-400/10 dark:to-indigo-500/10
                   blur-2xl rounded-full pointer-events-none"
          ></div>

          <!-- Video Frame Outer (Clean, single-bezel modern frame) -->
          <div class="relative rounded-2xl sm:rounded-3xl p-[1px] bg-linear-to-b from-slate-200/90 via-slate-200/60 to-slate-300/40 dark:from-neutral-700/80 dark:via-neutral-800/60 dark:to-neutral-900/40 shadow-xl shadow-slate-900/5 dark:shadow-2xl dark:shadow-black/70 overflow-hidden transition-colors duration-300">
            <div class="relative w-full aspect-video rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-950 dark:bg-black flex items-center justify-center">

              <!-- Video Player (Autoplay, muted, loop, viewport intersection observer) -->
              <video
                id="pramaanDemoVideo"
                class="w-full h-full object-cover"
                style="transform: scale(1.04) translateY(-1%); transform-origin: center;"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                width="800"
                height="450"
                poster="https://res.cloudinary.com/ddsbhdeju/image/upload/f_auto,q_auto,w_900/pramaan-demo-thumbnail.jpg"
              >
                <source
                  src="https://res.cloudinary.com/ddsbhdeju/video/upload/pramaan-demo.mp4"
                  type="video/mp4"
                />
                Your browser does not support HTML5 video.
              </video>

            </div>
          </div>

          <!-- Video Description / Caption (with info 'i' tag) -->
          <div class="mt-3.5 flex items-start justify-center lg:justify-start gap-2 text-xs sm:text-[13px] text-slate-500 dark:text-slate-400 text-center lg:text-left px-1">
            <span class="inline-flex items-center text-brand-orange shrink-0 mt-0.5" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <span class="leading-normal">
              See how OpenSpace uses Pramaan to authenticate users, handle consent, and securely exchange tokens.
            </span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<!-- Autoplay & Viewport Intersection Handler -->
<script>
  (function () {
    const video = document.getElementById("pramaanDemoVideo");
    if (!video) return;

    // Explicitly guarantee muted property for mobile browser autoplay policies
    video.muted = true;
    video.playsInline = true;

    const playSafe = () => {
      const p = video.play();
      if (p !== undefined) {
        p.catch(() => {});
      }
    };

    // Attempt autoplay immediately and when metadata / canplay fires
    playSafe();
    video.addEventListener("loadedmetadata", playSafe, { once: true });
    video.addEventListener("canplay", playSafe, { once: true });

    // Manage viewport play/pause to preserve battery and resources
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playSafe();
            } else {
              video.pause();
            }
          });
        },
        {
          threshold: 0.1,
        }
      );
      observer.observe(video);
    }
  })();
</script>
