<section id="demo" class="relative border-t border-slate-200/60 dark:border-neutral-800/80 bg-slate-50/40 dark:bg-transparent py-16 sm:py-24 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <p class="text-xs font-semibold text-brand-orange tracking-wider uppercase">DEMO SHOWCASE</p>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-slate-100 mt-2.5 sm:mt-3 font-brand-hero leading-tight">
        See Pramaan in action
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-400 font-medium max-w-2xl mx-auto leading-relaxed px-2">
        Watch how a third-party application signs in users, verifies consent, and securely exchanges tokens via Pramaan.
      </p>
    </div>

    <!-- Video Frame Container -->
    <div class="w-full max-w-4xl mx-auto">
      <div class="relative group">
        <!-- Video Frame Outer -->
        <div class="relative rounded-2xl sm:rounded-3xl bg-slate-900 dark:bg-[#0a0a0a] p-1 sm:p-2 border border-slate-200/80 dark:border-neutral-800 overflow-hidden">
          <div class="relative w-full aspect-video rounded-xl sm:rounded-2xl overflow-hidden bg-black flex items-center justify-center">

            <!-- Video Player (Autoplay, muted, loop, viewport intersection observer) -->
            <video
              id="pramaanDemoVideo"
              class="w-full h-full object-cover"
              style="transform: scale(1.04) translateY(-1%); transform-origin: center;"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              width="800"
              height="450"
              poster="https://res.cloudinary.com/ddsbhdeju/image/upload/f_auto,q_auto,w_900/pramaan-demo-thumbnail.jpg"
            >
              <source
                src="https://res.cloudinary.com/ddsbhdeju/video/upload/pramaan-demo.mp4"
                type="video/mp4"
              />
              Your browser does not support HTML5 video.
            </video>

          </div>
        </div>
      </div>

      <!-- Video Description / Caption -->
      <div class="mt-3 sm:mt-4 flex items-center justify-center gap-1.5 text-xs font-light text-slate-500 dark:text-slate-400 text-center px-2">
        <span class="inline-flex items-center text-brand-orange shrink-0" aria-hidden="true">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <span>
          See how OpenSpace uses Pramaan to authenticate users, handle consent, and securely exchange tokens.
        </span>
      </div>

    </div>

  </div>
</section>

<!-- Autoplay & Viewport Intersection Handler -->
<script>
  (function () {
    const video = document.getElementById("pramaanDemoVideo");
    if (!video) return;

    // Explicitly guarantee muted property for mobile browser autoplay policies
    video.muted = true;
    video.playsInline = true;

    const playSafe = () => {
      const p = video.play();
      if (p !== undefined) {
        p.catch(() => {});
      }
    };

    // Attempt autoplay immediately and when metadata / canplay fires
    playSafe();
    video.addEventListener("loadedmetadata", playSafe, { once: true });
    video.addEventListener("canplay", playSafe, { once: true });

    // Manage viewport play/pause to preserve battery and resources
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playSafe();
            } else {
              video.pause();
            }
          });
        },
        {
          threshold: 0.1,
        }
      );

      observer.observe(video);
    }
  })();
</script>
