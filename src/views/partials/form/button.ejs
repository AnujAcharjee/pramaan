<%
  const _type = typeof type !== 'undefined' ? type : 'submit';
  const _text = typeof text !== 'undefined' ? text : 'Submit';
  const _variant = typeof variant !== 'undefined' ? variant : 'primary';
  const _size = typeof size !== 'undefined' ? size : 'md';
  const _fullWidth = typeof fullWidth !== 'undefined' ? fullWidth : false;
  const _className = typeof className !== 'undefined' ? className : '';
  const _name = typeof name !== 'undefined' ? name : null;
  const _value = typeof value !== 'undefined' ? value : null;
  const _disabled = typeof disabled !== 'undefined' ? disabled : false;
  const _icon = typeof icon !== 'undefined' ? icon : null;

  const baseClasses = 'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-300 active:scale-[0.98] focus:outline-none focus:ring-4 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer';

  const sizeClasses = {
    sm: 'px-4 py-2 text-xs rounded-xl',
    md: 'px-5 py-3 text-sm rounded-xl',
    lg: 'px-7 py-3.5 text-base rounded-xl'
  };

  const variantClasses = {
    primary: 'bg-linear-to-r from-sky-500 via-sky-500/90 to-sky-600 text-white hover:shadow-lg hover:shadow-sky-500/15 focus:ring-sky-500/20',
    secondary: 'border-2 border-brand-orange text-brand-orange bg-white/40 dark:bg-brand-orange/10 backdrop-blur-xs hover:bg-brand-orange hover:text-white focus:ring-brand-orange/20',
    danger: 'bg-linear-to-r from-red-500 via-red-500/90 to-red-600 text-white hover:shadow-lg hover:shadow-red-500/15 focus:ring-red-500/20',
    ghost: 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 focus:ring-slate-100/30 dark:focus:ring-slate-700/30',
    outline: 'border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 bg-white/60 dark:bg-slate-800/40 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 focus:ring-slate-200/30 dark:focus:ring-slate-700/40'
  };

  const widthClass = _fullWidth ? 'w-full' : '';
%>

<button
  type="<%= _type %>"
  <% if (_name) { %>name="<%= _name %>"<% } %>
  <% if (_value) { %>value="<%= _value %>"<% } %>
  <% if (_disabled) { %>disabled<% } %>
  class="<%= baseClasses %> <%= sizeClasses[_size] %> <%= variantClasses[_variant] %> <%= widthClass %> <%= _className %>"
>
  <% if (_icon) { %><%- _icon %><% } %>
  <%= _text %>
</button>