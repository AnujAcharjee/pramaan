<%
  const _variant = typeof variant !== 'undefined' ? variant : 'default'; // default | success | warning | danger | info
  const _size = typeof size !== 'undefined' ? size : 'md'; // sm | md
  const _text = typeof text !== 'undefined' ? text : '';

  const sizeClasses = {
    sm: 'px-2 py-0.5 text-xs',
    md: 'px-3 py-1 text-sm'
  };

  const variantClasses = {
    default: 'bg-slate-100/90 dark:bg-slate-800/40 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/80',
    success: 'bg-emerald-50/90 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200/90 dark:border-emerald-500/30',
    warning: 'bg-amber-50/90 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-200/90 dark:border-amber-500/30',
    danger: 'bg-rose-50/90 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-200/90 dark:border-rose-500/30',
    info: 'bg-sky-50/90 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200/90 dark:border-sky-500/30'
  };
%>

<span class="inline-flex items-center font-semibold tracking-tight rounded-craftsman-stamp shadow-2xs <%= sizeClasses[_size] %> <%= variantClasses[_variant] %>">
  <%= _text %>
</span>
