# ==============================================================================
# Pramaan Backend Engine - Environment Configuration Template (.env.example)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=8080
RUN_SEEDS=false

# Application Configuration
APP_NAME=Pramaan
APP_DOMAIN=localhost:8080
APP_DOC_URL=https://github.com/AnujAcharjee/pramaan/blob/main/readme.md

# OpenID Connect Issuer & Frontend URL
AUTH_ISSUER=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Database Connection (Neon / PostgreSQL)
NEON_PG_DATABASE_URL=postgresql://user:password@localhost:5432/pramaan?sslmode=require

# Redis Cache & Ephemeral Sessions
REDIS_URL=redis://default:password@localhost:6379

# Resend Email Delivery
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=no-reply@pramaan.anujacharjee.com

# Cryptography & Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=at-least-32-characters-long-cookie-secret-key-change-in-production
KEY_ENC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CLIENT_SECRET_KEY=at-least-32-characters-long-client-secret-encryption-key-change

# Session & Token Lifespans (seconds)
ACTIVE_SESSION_EX=900
IDENTITY_SESSION_EX=15552000
EMAIL_VERIFICATION_TOKEN_EX=86400
SIGN_VERIFICATION_TOKEN_EX=86400
RESET_PASSWORD_EX=3600

# Rate Limiting & Lockout
MAX_SIGNIN_FAILURES=20
SIGNIN_LOCK_UNTIL=21600
SIGN_IN_FAIL_COUNT_EX=86400

# OAuth Lifespans
AUTH_CODE_EX=300
AUTH_TOKENS_EX=10m
AUTH_REQUEST_EX=300

# Cache Lifespans
PROFILE_CACHE_EX=900
CLIENT_CACHE_EX=900

# DNS TXT Domain Ownership Verification Resolvers
PRAMAAN_DNS_SERVERS=1.1.1.1,8.8.8.8

# Initial Super Admin (seeding)
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=Password123!

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Grafana Cloud Loki Log Ingestion (via Grafana Alloy)
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=your_grafana_instance_id
GRAFANA_CLOUD_LOKI_TOKEN=glc_your_generated_access_policy_token
