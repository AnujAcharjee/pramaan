{
  "name": "pramaan-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Pramaan - OAuth 2.0 & OIDC Identity Provider Backend",
  "author": "Anuj Acharjee",
  "license": "ISC",
  "main": "dist/index.js",
  "type": "module",
  "keywords": [
    "Pramaan",
    "OAuth",
    "OIDC"
  ],
  "scripts": {
    "format": "bunx prettier --write \"**/*.{ts,md}\"",
    "test": "bun test tests/**/*.test.ts",
    "build": "bunx tsc --build",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "keys:rotate": "bun src/scripts/rotate-keys.ts",
    "keys:rotate:prod": "bun dist/scripts/rotate-keys.js",
    "keys:migrate": "bun src/scripts/migrate-envelope-keys.ts",
    "keys:migrate:prod": "bun dist/scripts/migrate-envelope-keys.js",
    "docker:dev:build": "docker compose --project-name pramaan -f docker-compose.dev.yml build --no-cache",
    "docker:dev:up": "docker compose --project-name pramaan -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose --project-name pramaan -f docker-compose.dev.yml down -v",
    "prisma:dev:migrate": "bunx prisma migrate dev",
    "prisma:dev:migrate-reset": "bunx prisma migrate reset",
    "prisma:prod:migrate": "bunx prisma migrate deploy",
    "prisma:generate": "bunx prisma generate",
    "css:dev": "bunx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css --watch",
    "css:build": "bunx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css --minify",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/cli": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/method-override": "^3.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/streamifier": "^0.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "method-override": "^3.0.0",
    "module-alias": "^2.2.3",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "rate-limit-redis": "^6.0.2",
    "resend": "^6.25.0",
    "streamifier": "^0.1.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  }
}
