{
  "name": "pramaan",
  "version": "1.0.0",
  "private": true,
  "description": "An Identity provider",
  "author": "Anuj Acharjee",
  "license": "ISC",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "Pramaan"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{ts,md}\"",
    "test": "tsx --test tests/**/*.test.ts",
    "build": "npx tsc --build",
    "start": "node dist/index.js",
    "dev": "npx nodemon",
    "seed:dev": "tsx --tsconfig tsconfig.scripts.json scripts/dev.seed.ts",
    "seed:prod": "NODE_ENV=production tsx --tsconfig tsconfig.scripts.json scripts/prod.seed.ts",
    "docker:dev:build": "docker compose --project-name pramaan -f docker-compose.dev.yml build --no-cache",
    "docker:dev:up": "docker compose --project-name pramaan -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose --project-name pramaan -f docker-compose.dev.yml down -v",
    "prisma:dev:migrate": "npx prisma migrate dev",
    "prisma:dev:migrate-reset": "npx prisma migrate reset",
    "prisma:prod:migrate": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "css:dev": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css --watch",
    "css:build": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css --minify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/cli": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/method-override": "^3.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/streamifier": "^0.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "nodemon": "^3.1.13",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@logtail/node": "^0.5.8",
    "@logtail/winston": "^0.5.8",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "method-override": "^3.0.0",
    "module-alias": "^2.2.3",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "resend": "^6.25.0",
    "streamifier": "^0.1.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  }
}
