# ==============================================================================
# Pramaan Identity Provider - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development or .env.prod for production:
#   cp .env.example .env
#
# Generate cryptographically secure keys with Node.js:
#   COOKIE_SECRET:      node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   KEY_ENC_SECRET:     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   CLIENT_SECRET_KEY:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
# Mode: "development" | "production" | "test"
NODE_ENV=development

# Server HTTP Port
PORT=8080

# Run database seeds on startup ("true" | "false")
RUN_SEEDS=false

# ------------------------------------------------------------------------------
# 2. Application Identity & Reverse Proxy URLs
# ------------------------------------------------------------------------------
APP_NAME=Pramaan
APP_DOMAIN=localhost:8080
APP_DOC_URL=https://github.com/AnujAcharjee/pramaan/blob/main/readme.md

# OpenID Connect Issuer URL (must match discovery document issuer)
AUTH_ISSUER=http://localhost:8080

# Frontend SPA URL (Used for CORS and auth redirects in decoupled architecture)
# Local: http://localhost:3000 | Production: https://pramaan.anujacharjee.com or your Vercel URL
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Database Connection (PostgreSQL / Neon Database)
# ------------------------------------------------------------------------------
# Neon PostgreSQL pooled connection string
NEON_PG_DATABASE_URL=postgresql://user:password@localhost:5432/pramaan?sslmode=require

# ------------------------------------------------------------------------------
# 4. Redis Cache & Ephemeral Storage
# ------------------------------------------------------------------------------
# Upstash Redis / Redis connection URI
REDIS_URL=redis://default:password@localhost:6379

# ------------------------------------------------------------------------------
# 5. Email Delivery (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=no-reply@pramaan.anujacharjee.com

# ------------------------------------------------------------------------------
# 6. Cryptography & Encryption Secrets
# ------------------------------------------------------------------------------
# Session Cookie Signing Secret (minimum 32 characters, recommended 64-byte hex)
COOKIE_SECRET=at-least-32-characters-long-cookie-secret-key-change-in-production

# Symmetric Key Encryption Secret for OAuth Signing Keys (envelope encryption at rest)
# CRITICAL: Must be EXACTLY 32 bytes (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Secret Encryption Key (minimum 32 characters, recommended 64-byte hex)
CLIENT_SECRET_KEY=at-least-32-characters-long-client-secret-encryption-key-change

# ------------------------------------------------------------------------------
# 7. Session, Token & Lockout Lifespans (in seconds)
# ------------------------------------------------------------------------------
# Active short-lived session lifespan (10 min to 30 min: 600 - 1800 seconds)
ACTIVE_SESSION_EX=900

# Identity session / refresh cookie lifespan (180 to 360 days: 15552000 - 31104000 seconds)
IDENTITY_SESSION_EX=15552000

# Email verification token lifespan (max 24 hours: 86400 seconds)
EMAIL_VERIFICATION_TOKEN_EX=86400

# Sign-in email verification token lifespan (max 24 hours: 86400 seconds)
SIGN_VERIFICATION_TOKEN_EX=86400

# Password reset token lifespan (e.g. 1 hour: 3600 seconds)
RESET_PASSWORD_EX=3600

# Brute-force protection: Max sign-in failures before lockout
MAX_SIGNIN_FAILURES=20

# Lockout duration after exceeding MAX_SIGNIN_FAILURES (e.g. 6 hours: 21600 seconds)
SIGNIN_LOCK_UNTIL=21600

# Failure counter expiration (e.g. 24 hours: 86400 seconds)
SIGN_IN_FAIL_COUNT_EX=86400

# ------------------------------------------------------------------------------
# 8. OAuth 2.0 & OpenID Connect Lifespans
# ------------------------------------------------------------------------------
# Authorization code lifespan (seconds, e.g. 5 minutes: 300 seconds)
AUTH_CODE_EX=300

# Access / ID token lifespan (human duration string e.g. "10m", "1h")
AUTH_TOKENS_EX=10m

# Ephemeral authorization request state in Redis (seconds, e.g. 5 minutes: 300 seconds)
AUTH_REQUEST_EX=300

# Internal client metadata and profile cache TTLs (seconds)
PROFILE_CACHE_EX=900
CLIENT_CACHE_EX=900

# ------------------------------------------------------------------------------
# 9. DNS TXT Domain Ownership Verification Resolvers
# ------------------------------------------------------------------------------
# Comma-separated list of DNS resolver IPv4/IPv6 addresses (e.g. 1.1.1.1,8.8.8.8)
# If left blank, Pramaan uses the OS default DNS resolver
PRAMAAN_DNS_SERVERS=1.1.1.1,8.8.8.8

# ------------------------------------------------------------------------------
# 10. Initial Super Admin (Used only for local setup or database seeding)
# ------------------------------------------------------------------------------
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# 11. Cloudinary (Optional - User Avatar & Media Asset Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 12. Observability & Logging (Grafana Cloud Loki via Grafana Alloy)
# ------------------------------------------------------------------------------
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=your_grafana_instance_id
GRAFANA_CLOUD_LOKI_TOKEN=glc_your_generated_access_policy_token
