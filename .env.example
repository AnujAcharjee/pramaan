# Server Environment
NODE_ENV=development
PORT=8080

RUN_SEEDS=false

# Application Configuration
APP_NAME=Pramaan
APP_DOMAIN=localhost:8080
APP_DOC_URL=https://docs.pramaan.dev

# Cloudinary (Optional Profile Media Assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cookie Secret (At least 32 characters)
COOKIE_SECRET=at-least-32-characters-long-cookie-secret-key-here

# Database Connection (Neon / PostgreSQL)
NEON_PG_DATABASE_URL=postgresql://user:password@localhost:5432/pramaan?sslmode=require

# Initial Super Admin (Used for seeding)
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=Password123!

# Redis Cache & Sessions Connection URL
REDIS_URL=redis://default:password@localhost:6379

# Resend Email Delivery
RESEND_API_KEY=re_123456789
EMAIL_FROM=auth@example.com

# Session & Token Lifespans (in seconds)
ACTIVE_SESSION_EX=900
IDENTITY_SESSION_EX=15552000
EMAIL_VERIFICATION_TOKEN_EX=3600
SIGN_IN_FAIL_COUNT_EX=900
SIGN_VERIFICATION_TOKEN_EX=1800
SIGNIN_LOCK_UNTIL=1800
MAX_SIGNIN_FAILURES=5
RESET_PASSWORD_EX=3600

# OAuth 2.0 / OIDC Provider Configuration
AUTH_ISSUER=http://localhost:8080
AUTH_CODE_EX=600
AUTH_TOKENS_EX=3600
AUTH_REQUEST_EX=600

# Key Encryption Secret (Must be exactly 32 bytes / 64 hex characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Internal Cache Lifespans & Client Secrets (At least 32 characters for encryption key)
PROFILE_CACHE_EX=3600
CLIENT_CACHE_EX=3600
CLIENT_SECRET_KEY=at-least-32-characters-long-client-secret-encryption-key

# Telemetry / Structured Logging
LOGTAIL_SOURCE_TOKEN=your_logtail_source_token

# DNS TXT Domain Ownership Verification Resolvers
# Comma-separated list of DNS resolver IPv4/IPv6 addresses (e.g. 1.1.1.1,8.8.8.8). Optional; uses system resolver if unset.
PRAMAAN_DNS_SERVERS=1.1.1.1,8.8.8.8